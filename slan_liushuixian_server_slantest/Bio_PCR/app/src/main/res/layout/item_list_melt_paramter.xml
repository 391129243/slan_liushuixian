<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:background="@color/white">

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_melt_paramter_dye_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_melt_paramter_channel_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="1"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_melt_paramter_min_temp_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_melt_paramter_max_temp_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_melt_paramter_peakalgorithm_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_melt_paramter_peekhigh_threshold_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_melt_paramter_peektype_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
</androidx.appcompat.widget.LinearLayoutCompat>