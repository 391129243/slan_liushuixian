<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.paul.pipeline.fragment.PipeTrayFragment">
<data>
    <variable
        name="model"
        type="com.paul.pipeline.fragment.model.PipeTrayModel" />
    <variable
        name="viewModel"
        type="com.paul.pipeline.fragment.viewmodel.PipeTrayViewModel" />
</data>
<LinearLayout
    android:id="@+id/mainbg_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:stringStatusImg="@{model.status}"
    android:layout_margin="5dp"
    android:padding="5dp"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:stringStatusBg="@{model.status}">
        <TextView
            android:id="@+id/tv_trayname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_title"
            android:textSize="@dimen/pipemain_title"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:text="@{model.name}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_title"
            android:textSize="@dimen/pipemain_text"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            app:stringStatus ="@{model.status}"/>
    </RelativeLayout>
    <!--        <RelativeLayout-->
    <!--            android:layout_width="match_parent"-->
    <!--            android:layout_height="wrap_content"-->
    <!--            android:layout_marginBottom="5dp">-->
    <!--            <LinearLayout-->
    <!--                android:layout_width="wrap_content"-->
    <!--                android:layout_height="wrap_content"-->
    <!--                android:layout_centerHorizontal="true"-->
    <!--                android:gravity="center"-->
    <!--                android:orientation="horizontal"-->
    <!--                android:layout_alignParentLeft="true">-->
    <!--                <TextView-->
    <!--                    android:layout_width="wrap_content"-->
    <!--                    android:layout_height="wrap_content"-->
    <!--                    android:gravity="center"-->
    <!--                    android:text="@string/sample_hole_list"-->
    <!--                    android:layout_marginLeft="10dp"-->
    <!--                    android:textColor="@color/color_user_main_text"-->
    <!--                    android:textSize="@dimen/pipemain_text"/>-->
    <!--            </LinearLayout>-->
    <!--        </RelativeLayout>-->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentTop="true"
            android:layout_above="@id/bottom_rl"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/samplehole_rv"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:orientation="horizontal"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_user_main_text"
                    android:textSize="14sp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:text="@string/result_batchCode" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_title"
                    android:textAlignment="textStart"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="5dp"
                    android:text="@{model.batch}"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="marquee"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color_user_main_text"
                    android:textSize="14sp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:text="@string/config_info_project_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="5dp"
                    android:text="@{model.project}"
                    android:textColor="@color/content_title"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="marquee"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="2dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/first_rna_title_tv">

                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        app:intToString="@{model.dispatch.index}"
                        android:textColor="@color/white"
                        android:layout_gravity="center_horizontal"
                        android:background="@drawable/shape_oval_top_bg"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="2dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/blue"
                        android:text="@{model.dispatch.name}" />

                    <TextView
                        android:id="@+id/first_rna_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:text="@{model.dispatch.templatename}"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_alignParentLeft="true"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/pipe_main_aim_position"
                        android:textColor="@color/color_user_main_text"
                        android:textSize="14sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        app:intTypeName ="@{model.dispatch.targettype}"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        app:intToString="@{model.dispatch.target}"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/bottom_rl"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_alignParentBottom="true"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/content_title"
                android:textSize="@dimen/pipemain_text"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                app:booleanUrgentString="@{model.urgent}" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_title"
                    android:textSize="14sp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:text="@string/exist_check" />

                <com.gidi.bio_pcr.view.CustomView
                    android:layout_marginLeft="5dp"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    app:existImg="@{model.exist}"/> />
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>

</LinearLayout>
</layout>