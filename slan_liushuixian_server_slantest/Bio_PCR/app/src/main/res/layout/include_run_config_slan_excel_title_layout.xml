<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:background="@color/blue">
    <TextView
        android:id="@+id/result_excel_wellname_tv"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_wellname"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>


    <TextView
        android:id="@+id/result_excel_channel_tv"
        android:layout_width="62dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_channel"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_controlct_tv"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:text="@string/running_excel_controlct"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <!---阈值或峰高阈值-->
    <TextView
        android:id="@+id/result_run_slan_excel_threshold_tv"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_controlrn"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_isauth_tv"
        android:layout_width="62dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="AutoRn"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_ct_tv"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="Ct"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_rmvalue_tv"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="RmValues"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_tmvalue_tv"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="TmValues"
        android:textColor="@color/white"/>
</LinearLayout>