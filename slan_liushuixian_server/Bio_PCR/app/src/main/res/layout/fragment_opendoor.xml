<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="model"
            type="com.paul.pipeline.fragment.model.PipeDoorModel" />
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.OpendoorViewModel" />
    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/untouchview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:background="#50000000">
        </View>
        <RelativeLayout
            android:id="@+id/content"
            android:layout_width="1280dp"
            android:layout_height="wrap_content"
            tools:context="com.paul.pipeline.fragment.OpendoorFragment"
            android:background="@color/white"
            android:layout_centerInParent="true"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentTop="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentTop="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_title"
                        android:textSize="@dimen/pipemain_title"
                        android:layout_centerVertical="true"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="10dp"
                        android:text="@string/name_opendoor" />

                    <ImageView
                        android:id="@+id/iv_back"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="20dp"
                        android:padding="10dp"
                        android:background="@drawable/icon_back_1"/>
                </RelativeLayout>
                <!--启动自检-->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <TextView
                        android:id="@+id/alert_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:textColor="#0CBEE2"
                        android:textSize="@dimen/font_size_xlarge_28sp"
                        android:textStyle="bold" />

                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_centerInParent="true">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/doorhold"
                            android:textColor="@color/black"
                            android:textSize="16sp" />
                        <com.gidi.bio_pcr.view.CustomView
                            android:layout_marginLeft="10dp"
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            app:booleanToImg="@{model.doorhold}"/>
                    </LinearLayout>
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginLeft="20dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/armhold"
                                android:textColor="@color/black"
                                android:textSize="16sp" />
                            <com.gidi.bio_pcr.view.CustomView
                                android:layout_marginLeft="10dp"
                                android:layout_width="20dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                app:booleanToImg="@{model.armhold}"/>
                        </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginLeft="20dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/doorposition"
                            android:textColor="@color/black"
                            android:textSize="16sp" />
                        <com.gidi.bio_pcr.view.CustomView
                            android:layout_marginLeft="10dp"
                            android:layout_width="20dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            app:booleanToImg="@{model.doorposition}"/>
                    </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_alignParentBottom="true">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_centerInParent="true">
                    <Button
                        android:id="@+id/opendoor_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="@string/btn_open_door"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
<!--                        <Button-->
<!--                            android:id="@+id/managetray_btn"-->
<!--                            android:layout_width="wrap_content"-->
<!--                            android:layout_height="50dp"-->
<!--                            android:layout_marginLeft="20dp"-->
<!--                            android:paddingLeft="10dp"-->
<!--                            android:paddingRight="10dp"-->
<!--                            android:text="@string/btn_manage_tray"-->
<!--                            android:textSize="20sp"-->
<!--                            android:textColor="@color/white"-->
<!--                            android:background="@drawable/selector_general_btn_bg"/>-->
                    <Button
                        android:id="@+id/closedoor_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginLeft="20dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="@string/btn_close_door"
                        android:textSize="20sp"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
                    </LinearLayout>

                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</layout>
