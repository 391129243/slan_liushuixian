<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <runtime>
    <legacyCorruptedStateExceptionsPolicy enabled="true" />
    <AppContextSwitchOverrides value="Switch.System.IO.Ports.DoNotCatchSerialStreamThreadExceptions=false" />
  </runtime>
	<appSettings>
		<add key="HSSERVICELOCALHOST" value="http://127.0.0.1:2966"/>
		<add key="SERVICELOCALHOST" value="http://127.0.0.1:6088"/>
		<add key="SAHOSTURL" value="http://127.0.0.1:6088/"/>
		<add key="SAAUTHHOSTURL" value="#/auth/home?toppanel=1&amp;t={0}&amp;lang={1}&amp;token="/>
		<add key="SALOGHOSTURL" value="#/log/home?toppanel=1&amp;t={0}&amp;lang={1}&amp;token="/>
		<add key="SASYSTEMHOSTURL" value="#/system/home?toppanel=1&amp;t={0}&amp;lang={1}&amp;token="/>
	</appSettings>
</configuration>