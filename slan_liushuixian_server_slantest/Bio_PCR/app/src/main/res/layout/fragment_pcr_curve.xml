<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    tools:context="com.paul.pipeline.fragment.PcrCurveFragment">
    <data>
        <variable
            name="model"
            type="com.paul.pipeline.fragment.model.PipePCRModel" />

    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">
        <LinearLayout
            android:id="@+id/bowei_running_slan_chanel_layout"
            android:layout_below="@id/bowei_result_slan_curve_layout"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <com.paul.pipeline.view.MiniCheckText
                android:id="@+id/bowei_result_slan_all_channel_check_tv"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="5dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_all_channel_bg"
                custom:content_text="All" />

            <com.paul.pipeline.view.MiniCheckText
                android:id="@+id/bowei_running_slan_result_fam_tv"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="2dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_fam_bg"
                custom:content_text="FAM"/>

            <com.paul.pipeline.view.MiniCheckText
                android:id="@+id/bowei_running_slan_result_hex_tv"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="2dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_hex_bg"
                custom:content_text="HEX"/>


            <com.paul.pipeline.view.MiniCheckText
                android:id="@+id/bowei_running_slan_result_rox_tv"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="2dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_rox_bg"
                custom:content_text="ROX"/>

            <com.paul.pipeline.view.MiniCheckText
                android:id="@+id/bowei_running_slan_result_cy5_tv"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginTop="2dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_cy5_bg"
                custom:content_text="CY5"/>


        </LinearLayout>
        <RadioGroup
            android:id="@+id/bowei_result_slan_curve_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="horizontal">
            <RadioButton
                android:layout_height="28dp"
                style="@style/style_tab_system_info_test"
                android:id="@+id/bowei_result_slan_rawcurve_rb"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Raw"
                android:textSize="10sp"
                />
            <!-- RadioButton AMP curve hidden
            <RadioButton
                android:layout_height="28dp"
                style="@style/style_tab_system_info_test"
                android:id="@+id/bowei_result_slan_ampcurve_rb"
                android:layout_marginLeft="2dp"
                android:textSize="10sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="AMP"
                />
            -->
            <RadioButton
                android:layout_height="28dp"
                style="@style/style_tab_system_info_test"
                android:id="@+id/bowei_result_slan_meltcurve_rb"
                android:layout_marginLeft="2dp"
                android:textSize="10sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Melt"
                />
            <!-- RadioButton Melt Peak curve hidden
            <RadioButton
                android:layout_height="28dp"
                style="@style/style_tab_system_info_test"
                android:id="@+id/bowei_result_slan_peakcurve_rb"
                android:layout_marginLeft="2dp"
                android:textSize="10sp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Melt Peak"
                />
            -->
            <!--                        <RadioButton-->
            <!--                            android:layout_height="28dp"-->
            <!--                            style="@style/style_tab_system_info_test"-->
            <!--                            android:id="@+id/bowei_result_slan_list_rb"-->
            <!--                            android:layout_marginLeft="2dp"-->
            <!--                            android:textSize="10sp"-->
            <!--                            android:layout_width="0dp"-->
            <!--                            android:layout_weight="1"-->
            <!--                            android:text="@string/running_curve_excel"-->
            <!--                            />-->
            <!--                        <RadioButton-->
            <!--                            android:layout_height="28dp"-->
            <!--                            style="@style/style_tab_system_info_test"-->
            <!--                            android:id="@+id/bowei_result_slan_set_paramter_rb"-->
            <!--                            android:layout_marginLeft="2dp"-->
            <!--                            android:textSize="10sp"-->
            <!--                            android:layout_width="0dp"-->
            <!--                            android:layout_weight="1"-->
            <!--                            android:text="@string/running_curve_set_paramter"-->
            <!--                            />-->
        </RadioGroup>
        <!--显示曲线-->

        <!-- Raw 曲线图表 -->
        <LinearLayout
            android:id="@+id/bowei_result_slan_raw_chart_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_below="@id/bowei_result_slan_curve_layout"
            android:layout_toRightOf="@id/bowei_running_slan_chanel_layout"
            android:visibility="visible">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/bowei_running_result_slan_raw_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:layout_marginTop="5dp"
                android:background="#f3f5f8"/>
        </LinearLayout>

        <!-- Melt 曲线图表 -->
        <LinearLayout
            android:id="@+id/bowei_result_slan_melt_chart_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_below="@id/bowei_result_slan_curve_layout"
            android:layout_toRightOf="@id/bowei_running_slan_chanel_layout"
            android:visibility="gone">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/bowei_running_result_slan_melt_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:layout_marginTop="5dp"
                android:background="#f3f5f8"/>
        </LinearLayout>
        <!--显示参数-->

    </RelativeLayout>
</layout>