<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.paul.pipeline.fragment.TrayProjectListFragment">

    <data>
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.TrayDetailViewModel" />
    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
        android:id="@+id/rl_btn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_alignParentLeft="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true">
            <RadioGroup
                android:id="@+id/templatetype_rg"
                android:layout_width="wrap_content"
                android:layout_height="140dp"
                android:layout_marginTop="10dp"
                android:orientation="vertical">
                <RadioButton
                    style="@style/style_tab_upload_mode_rb"
                    android:id="@+id/full_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/main_tab_project"
                    android:checked="@{viewModel.radioGroupTempType==0}"/>
                <RadioButton
                    style="@style/style_tab_upload_mode_rb"
                    android:id="@+id/rna_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/main_tab_rna_extraction"
                    android:checked="@{viewModel.radioGroupTempType==1}"/>
                <RadioButton
                    style="@style/style_tab_upload_mode_rb"
                    android:id="@+id/pcr_rb"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="@string/pipe_main_pcr_name"
                    android:checked="@{viewModel.radioGroupTempType==2}"/>
            </RadioGroup>

        </LinearLayout>

    </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/template_list_recycleview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:layout_toRightOf="@id/rl_btn"/>
    </RelativeLayout>

</layout>