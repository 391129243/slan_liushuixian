<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:background="#f3f5f8">
    <TextView
        android:id="@+id/item_ex_result_excel_wellname_tv"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="A1"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_result_excel_regentCode_tv"
        android:layout_weight="2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_result_excel_idcard_tv"
        android:layout_weight="3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_result_excel_channel_tv"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="FAM"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_result_excel_controlct_tv"
        android:layout_weight="1.5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="ControlCt"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line" />
    <TextView
        android:id="@+id/item_result_excel_controlpeak_tv"
        android:layout_weight="1.5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="1dp"
        android:gravity="center"
        android:textSize="13sp"
        android:text="@string/running_excel_controlpeak"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line" />
    <!--閾值-->
    <TextView
        android:id="@+id/item_ex_result_slan_excel_controlrn_tv"
        android:layout_weight="1.5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="ControlRn"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>

    <TextView
        android:id="@+id/item_ex_result_slan_excel_peek_highThd_tv"
        android:layout_weight="1.5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="PeekHighThd"
        android:textColor="@color/blue"/>

    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_result_excel_ct_tv"
        android:layout_weight="1.5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/blue"/>
    <!--多重的rnValue-->
    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_result_excel_rmvalue_tv"
        android:layout_weight="1.5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_result_excel_peakvalue_tv"
        android:layout_weight="1.5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>

    <TextView
        android:id="@+id/item_ex_excel_conclusion_tv"
        android:layout_weight="3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/blue"/>
    <View
        style="@style/style_portrait_line"/>
    <TextView
        android:id="@+id/item_ex_excel_conclusion_1_tv"
        android:layout_weight="3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/blue"/>

</LinearLayout>