<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/white"
    tools:context="com.paul.pipeline.fragment.RecordsFragment">


        <LinearLayout
            android:id="@+id/result_tab_layout"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/color_bioway_top_bar_bg">
            <LinearLayout
                android:id="@+id/result_experiment_tab"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_experiment"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/expriment_recond"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>
            <LinearLayout
                android:id="@+id/result_wellresult_tab"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_well"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/wellresult_recond"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/result_frame_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F5F5F5">

        </FrameLayout>


</LinearLayout>