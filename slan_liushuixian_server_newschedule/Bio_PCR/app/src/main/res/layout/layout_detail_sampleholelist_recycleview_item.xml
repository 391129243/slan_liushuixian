<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="data"
            type="com.paul.pipeline.model.SampleHoleModel" />
        <variable
            name="recyclerViewItemClick"
            type="com.paul.pipeline.adapter.DetailSampleHoleListAdapter.RecyclerViewItemClickMethod" />
    </data>
    <LinearLayout
        android:id="@+id/mainbg_ll"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="@drawable/selector_tray_item_bg"
        android:onClick="@{recyclerViewItemClick::trayViewClick}">
    <LinearLayout
        android:id="@+id/hole_rl"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">
<!--        <CheckBox-->
<!--            android:id="@+id/samplehole_cb"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_gravity="center_vertical"-->
<!--            android:layout_marginLeft="10dp"-->
<!--            android:button="@drawable/selector_item_file_check_bg"-->
<!--            android:checked="@{data.selected}"/>-->
        <ImageView
            android:id="@+id/samplehole_cb"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/item_file_uncheck"/>
        <TextView
            android:id="@+id/hole_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/color_user_main_text"
            android:textSize="@dimen/font_size_normal_18sp"
            android:layout_gravity="center_vertical"
            android:text="@{data.name}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="center_vertical"
            android:textColor="@color/content_text"
            android:textSize="@dimen/pipemain_hole_text" />
    </LinearLayout>
        <LinearLayout
            android:id="@+id/search_layout"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="20dp"
            android:orientation="horizontal">
            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:textSize="@dimen/pipemain_hole_text"
                android:layout_gravity="center_vertical"
                android:textColor="@color/color_user_main_text"
                android:text="@string/result_reagent"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="150dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:textSize="@dimen/font_size_normal_16sp"
                android:textColor="@color/content_text"
                android:text="@{data.reagentCode}"
               />

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/pipemain_hole_text"
                android:textColor="@color/color_user_main_text"
                android:layout_marginLeft="20dp"
                android:text="@string/result_idcard" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="100dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:textSize="@dimen/font_size_normal_16sp"
                android:textColor="@color/content_text"
                android:text="@{data.serialNum}"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="5dp"
                android:textSize="12sp"
                android:textColor="@color/red"
                android:text="@{data.scaninfo}"
                />
        </LinearLayout>
    </LinearLayout>
</layout>