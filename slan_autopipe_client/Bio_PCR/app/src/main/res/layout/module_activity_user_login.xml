<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:custom="http://schemas.android.com/apk/res-auto">
    <!--启动自检-->
    <RelativeLayout
        android:id="@+id/login_auto_check_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_bg_2">

        <TextView
            android:id="@+id/login_selfcheck_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="40dp"
            android:text="@string/system_self_check"
            android:textColor="#0CBEE2"
            android:textSize="@dimen/font_size_xlarge_28sp"
            android:textStyle="bold" />

    </RelativeLayout>

</RelativeLayout>