<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_detect_result_layout"
    android:layout_width="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_height="112dp">
    <TextView
        android:id="@+id/item_list_result_num_tv"
        style="@style/style_ex_result_item_title"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:textColor="@color/color_main_title"
        android:textSize="@dimen/font_size_large_22sp"
        android:text="@string/result_num"/>
    <TextView
        android:id="@+id/item_list_result_regent_tv"
        style="@style/style_ex_result_item_title"
        android:text="@string/result_reagent"
        android:layout_width="0dp"
        android:layout_weight="5"
        android:textSize="@dimen/font_size_large_22sp"
        android:textColor="@color/color_main_title"/>
    <TextView
        android:id="@+id/item_list_result_time_tv"
        style="@style/style_ex_result_item_title"
        android:layout_width="0dp"
        android:layout_weight="4"
        android:textSize="@dimen/font_size_large_22sp"
        android:textColor="@color/color_main_title"/>
    <TextView
        android:id="@+id/item_list_result_idcard_tv"
        android:layout_width="0dp"
        android:layout_weight="5"
        style="@style/style_ex_result_item_title"
        android:text="@string/result_idcard"
        android:textSize="@dimen/font_size_large_22sp"
        android:textColor="@color/color_main_title"/>
    <TextView
        android:id="@+id/item_list_result_testitem_tv"
        style="@style/style_ex_result_item_title"
        android:layout_width="0dp"
        android:layout_weight="5"
        android:text="@string/result_testitem"
        android:textSize="@dimen/font_size_large_22sp"
        android:textColor="@color/color_main_title"/>
    <ImageView
        android:id="@+id/item_well_result_ck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:src="@drawable/item_unchecked"
        android:visibility="invisible" />
</LinearLayout>