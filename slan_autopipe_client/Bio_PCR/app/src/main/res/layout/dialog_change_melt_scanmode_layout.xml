<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">
    <RadioGroup
        android:id="@+id/dialog_scanmode_rg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/dialog_scanmode_continuous_tv"
            android:layout_width="118dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/blue"
            android:text="Continuous"
            android:button="@null"
            android:background="@drawable/selector_rect_blue_stroke"/>

        <RadioButton
            android:id="@+id/dialog_scanmode_step_tv"
            android:layout_width="118dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:layout_marginLeft="24dp"
            android:textColor="@color/blue"
            android:text="Step"
            android:button="@null"
            android:background="@drawable/selector_rect_blue_stroke"/>
    </RadioGroup>


</LinearLayout>