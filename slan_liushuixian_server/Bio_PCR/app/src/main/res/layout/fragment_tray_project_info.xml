<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    tools:context="com.paul.pipeline.fragment.TrayProjectInfoFragment">
    <data>
        <variable
            name="model"
            type="com.paul.pipeline.model.TemplateModel" />
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.TrayDetailViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_rect_white_bg">
        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:text="@{viewModel.tempTypeName}"
                    android:layout_alignParentLeft="true"
                    android:layout_centerVertical="true"
                    android:layout_marginLeft="10dp"/>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal">
            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/create_multi_template_name"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_normal_18sp" />

                <EditText
                    android:id="@+id/template_name_et"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/shape_rect_stoke"
                    android:inputType="none"
                    android:padding="4dp"
                    android:singleLine="true"
                    android:enabled="false"
                    android:text="@{model.firstName}"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:paddingLeft="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/create_multi_template_second_name"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_normal_18sp" />

                <EditText
                    android:id="@+id/template_name_second_et"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/shape_rect_stoke"
                    android:inputType="none"
                    android:padding="4dp"
                    android:singleLine="true"
                    android:enabled="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:text="@{model.secondName}"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:paddingLeft="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="8dp"
                    android:text="@string/create_multi_template_third_name"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_normal_18sp" />

                <EditText
                    android:id="@+id/template_name_third_et"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:background="@drawable/shape_rect_stoke"
                    android:inputType="none"
                    android:padding="4dp"
                    android:singleLine="true"
                    android:enabled="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:text="@{model.thirdName}"/>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/ll_top">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/ll_full_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/single_full_totaltime_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/create_multi_template_time"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <EditText
                        android:id="@+id/single_full_totaltime_et"
                        android:layout_width="188dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/shape_rect_stoke"
                        android:inputType="none"
                        android:padding="4dp"
                        android:singleLine="true"
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginLeft="8dp"
                        android:text="s"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/font_size_normal_18sp" />

                </LinearLayout>
                <!--控温方式-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/font_size_normal_18sp"
                        android:text="@string/create_multi_temperature_control"/>
                    <RadioGroup
                        android:id="@+id/single_full_tempctrl_mode_rg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/single_full_tempctrl_fast"
                            style="@style/style_tab_temperature_ctrl_rb"
                            android:checked="true"
                            android:paddingRight="8dp"
                            android:layout_width="wrap_content"
                            android:textSize="@dimen/font_size_normal_18sp"
                            android:text="@string/create_multi_temperature_fast"/>
                        <RadioButton
                            android:id="@+id/single_full_tempctrl_standard"
                            style="@style/style_tab_temperature_ctrl_rb"
                            android:layout_marginLeft="6dp"
                            android:layout_width="wrap_content"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/font_size_normal_18sp"
                            android:text="@string/create_multi_temperature_standard"/>
                    </RadioGroup>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                <com.gidi.bio_pcr.view.CustomMiniImageText
                    android:id="@+id/single_full_rna_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/rna_extraction"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="1"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/single_full_rna_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                <com.gidi.bio_pcr.view.CustomMiniImageText
                    android:id="@+id/single_full_pcr_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/single_template_first_pcr"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="2"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/single_full_pcr_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                <com.gidi.bio_pcr.view.CustomMiniImageText
                    android:id="@+id/single_full_peak_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/create_multi_peak_judge_file"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="3"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/single_full_peak_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                <com.gidi.bio_pcr.view.CustomMiniImageText
                    android:id="@+id/single_full_judge_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/create_multi_ct_judge_file"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="4"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/single_full_judge_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_full_multi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/multi_full_totaltime_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="@string/create_multi_template_time"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <EditText
                        android:id="@+id/multi_full_totaltime_et"
                        android:layout_width="188dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:background="@drawable/shape_rect_stoke"
                        android:inputType="none"
                        android:padding="4dp"
                        android:singleLine="true"
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginLeft="8dp"
                        android:text="s"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/font_size_normal_18sp" />

                </LinearLayout>
                <!--控温方式-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="8dp"
                        android:textColor="@color/blue"
                        android:gravity="center"
                        android:textSize="@dimen/font_size_normal_18sp"
                        android:text="@string/create_multi_temperature_control"/>
                    <RadioGroup
                        android:id="@+id/multi_full_tempctrl_mode_rg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/multi_full_tempctrl_fast"
                            style="@style/style_tab_temperature_ctrl_rb"
                            android:checked="true"
                            android:paddingRight="8dp"
                            android:layout_width="wrap_content"
                            android:textSize="@dimen/font_size_normal_18sp"
                            android:text="@string/create_multi_temperature_fast"/>
                        <RadioButton
                            android:id="@+id/multi_full_tempctrl_standard"
                            style="@style/style_tab_temperature_ctrl_rb"
                            android:layout_marginLeft="6dp"
                            android:layout_width="wrap_content"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/font_size_normal_18sp"
                            android:text="@string/create_multi_temperature_standard"/>
                    </RadioGroup>
                </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal">
            <com.gidi.bio_pcr.view.CustomMiniImageText
                android:id="@+id/multi_full_first_rna_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                custom:content_text="@string/rna_extraction"
                custom:content_text_color="@color/blue"
                custom:content_img="@drawable/shape_oval_top_bg"
                custom:image_content_text_color="@color/white"
                custom:image_content_text="1" />

            <TextView
                android:id="@+id/multi_full_first_rna_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_gravity="center_vertical"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/black" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal">
        <com.gidi.bio_pcr.view.CustomMiniImageText
            android:id="@+id/multi_full_first_pcr_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            custom:content_text="@string/multi_template_first_pcr"
            custom:content_text_color="@color/blue"
            custom:content_img="@drawable/shape_oval_top_bg"
            custom:image_content_text_color="@color/white"
            custom:image_content_text="2" />

        <TextView
            android:id="@+id/multi_full_first_pcr_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/black" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal">
        <com.gidi.bio_pcr.view.CustomMiniImageText
            android:id="@+id/multi_full_second_rna_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            custom:content_text="@string/rna_extraction"
            custom:content_text_color="@color/blue"
            custom:content_img="@drawable/shape_oval_top_bg"
            custom:image_content_text_color="@color/white"
            custom:image_content_text="3" />

        <TextView
            android:id="@+id/multi_full_second_rna_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/black" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal">
        <com.gidi.bio_pcr.view.CustomMiniImageText
            android:id="@+id/multi_full_second_pcr_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            custom:content_text="@string/multi_template_first_pcr"
            custom:content_text_color="@color/blue"
            custom:content_img="@drawable/shape_oval_top_bg"
            custom:image_content_text_color="@color/white"
            custom:image_content_text="4" />

        <TextView
            android:id="@+id/multi_full_second_pcr_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_gravity="center_vertical"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/black"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal">
        <com.gidi.bio_pcr.view.CustomMiniImageText
            android:id="@+id/multi_full_peak_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            custom:content_text="@string/create_multi_peak_judge_file"
            custom:content_text_color="@color/blue"
            custom:content_img="@drawable/shape_oval_top_bg"
            custom:image_content_text_color="@color/white"
            custom:image_content_text="5" />

            <TextView
                android:id="@+id/multi_full_peak_file_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp" />
        </LinearLayout>
        <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal">
                    <com.gidi.bio_pcr.view.CustomMiniImageText
                        android:id="@+id/multi_full_judge_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        custom:content_text="@string/create_multi_ct_judge_file"
                        custom:content_text_color="@color/blue"
                        custom:content_img="@drawable/shape_oval_top_bg"
                        custom:image_content_text_color="@color/white"
                        custom:image_content_text="6" />

                    <TextView
                        android:id="@+id/multi_full_judge_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_gravity="center_vertical"
                        android:textSize="@dimen/font_size_normal_18sp"
                        android:textColor="@color/black" />
                    </LinearLayout>
    </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_rna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/rna_totaltime_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="@string/create_single_rna_time"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/font_size_normal_18sp" />

                        <EditText
                            android:id="@+id/rna_totaltime_et"
                            android:layout_width="172dp"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:layout_marginLeft="4dp"
                            android:background="@drawable/shape_rect_stoke"
                            android:inputType="number"
                            android:padding="4dp"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textSize="@dimen/font_size_normal_18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:layout_marginLeft="8dp"
                            android:text="s"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/font_size_normal_18sp" />
                    </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.gidi.bio_pcr.view.CustomMiniImageText
                        android:id="@+id/rna_title_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        custom:content_img="@drawable/shape_oval_top_bg"
                        custom:content_text="@string/rna_extraction"
                        custom:content_text_color="@color/blue"
                        custom:image_content_text="1"
                        custom:image_content_text_color="@color/white"
                        android:layout_gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/rna_name_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_normal_18sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_pcr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/shape_rect_white_bg"
                android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:orientation="horizontal"
                        android:paddingLeft="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/pcr_totaltime_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="@string/create_single_pcr_time"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/font_size_normal_18sp" />

                        <EditText
                            android:id="@+id/pcr_totaltime_et"
                            android:layout_width="208dp"
                            android:layout_height="35dp"
                            android:layout_marginLeft="8dp"
                            android:enabled="false"
                            android:background="@drawable/shape_rect_stoke"
                            android:inputType="number"
                            android:padding="4dp"
                            android:maxLength="4"
                            android:singleLine="true"
                            android:textColor="@color/black"
                            android:textSize="@dimen/font_size_normal_18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="8dp"
                            android:text="s"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/font_size_normal_18sp" />
                    </LinearLayout>
                    <!--控温方式-->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center_vertical"
                        android:layout_marginLeft="8dp"
                        android:layout_marginRight="8dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
