<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="@color/white"
    xmlns:custom="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/tab_title_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginLeft="12dp"
        android:layout_centerVertical="true"
        android:textColor="@color/blue"
        android:textSize="@dimen/font_size_large_22sp"/>
    <!--显示时间-->
    <com.gzlab.autoassemblyline_client.view.DateTimeView
        android:id="@+id/tab_time_ll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:layout_marginRight="8dp"
        custom:title_text_color="@color/black"
        custom:content_text_color="@color/black">
    </com.gzlab.autoassemblyline_client.view.DateTimeView>
    <ImageView
        android:id="@+id/tab_back_img"
        android:layout_width="wrap_content"
        android:padding="12dp"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@id/tab_time_ll"
        android:layout_marginRight="40dp"
        android:layout_centerVertical="true"
        android:src="@drawable/icon_main"
        android:background="@drawable/shape_oval_top_bg"
        android:contentDescription="@null"/>

</RelativeLayout>