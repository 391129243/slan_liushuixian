<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.paul.pipeline.fragment.PipeRnaFragment">
<data>
    <variable
        name="model"
        type="com.paul.pipeline.fragment.model.PipeRNAModel" />
</data>
<LinearLayout
    android:id="@+id/mainbg_ll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:stringStatusImg="@{model.allstatus}"
    android:padding="@dimen/content_padding"
    android:layout_margin="5dp"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_margin="5dp"
        app:stringStatusBg="@{model.allstatus}">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_title"
            android:textSize="@dimen/pipemain_title"
            android:layout_centerVertical="true"
            android:layout_alignParentLeft="true"
            android:text="@{model.name}" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_title"
            android:textSize="@dimen/pipemain_text"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            app:intStepString="@{model.armStep}"
            app:trayExist="@{model.exist}"
            app:allStatus="@{model.allstatus}" />
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:id="@+id/first_rna"
            android:orientation="vertical"
            android:layout_above="@id/bottom_rl">

            <LinearLayout
                android:id="@+id/running_first_counter_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/first_rna_counter_img"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/icon_remaining_time"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/first_rna_counter_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/running_fragment_remaining_time"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/color_user_main_text"
                    android:textSize="18sp" />
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/running_first_counter_layout"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_centerInParent="true"
                android:background="@drawable/first_rna_countdown_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:intToString="@{model.leftTime}"
                    android:layout_centerInParent="true"
                    android:textColor="@color/white"
                    android:textSize="24sp" />
                <!--                <Chronometer-->
                <!--                    android:id="@+id/first_rna_chronometer"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:layout_centerInParent="true"-->
                <!--                    android:textColor="@color/white"-->
                <!--                    android:textSize="24sp" />-->
            </RelativeLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_centerHorizontal="true"
                android:gravity="left"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/pipe_main_run_totaltime"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/color_user_main_text"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/totaltime_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:intToString="@{model.totalTime}"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/color_user_main_value"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="left"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginLeft="10dp"
                    android:text="@string/pipe_main_source_position"
                    android:textColor="@color/color_user_main_text"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginLeft="5dp"
                    app:intTrayString="@{model.currentTray}"
                    android:textColor="@color/color_user_main_value"
                    android:textSize="14sp" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:gravity="left"
                android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/pipe_main_temprature"
                        android:layout_marginLeft="10dp"
                        android:textColor="@color/color_user_main_text"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@{model.degree}"
                        android:layout_marginLeft="10dp"
                        android:textColor="@color/color_user_main_value"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="℃"
                        android:layout_marginLeft="10dp"
                        android:textColor="@color/color_user_main_value"
                        android:textSize="14sp" />
                </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_centerHorizontal="true"
                android:gravity="left"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pipe_main_template_name"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/color_user_main_text"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{model.currentTemplate}"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/color_user_main_value"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_centerHorizontal="true"
                android:gravity="left"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pipe_main_template_info"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/color_user_main_text"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{model.info}"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/color_user_main_value"
                    android:textSize="14sp" />
            </LinearLayout>

<!--            <LinearLayout-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginBottom="5dp"-->
<!--                android:layout_centerHorizontal="true"-->
<!--                android:gravity="left"-->
<!--                android:orientation="horizontal">-->
<!--                <TextView-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:gravity="center"-->
<!--                    android:text="@string/pipe_main_run_info"-->
<!--                    android:layout_marginLeft="10dp"-->
<!--                    android:textColor="@color/color_user_main_text"-->
<!--                    android:textSize="14sp" />-->
<!--                <TextView-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:gravity="center"-->
<!--                    android:text="@{model.runninginfo}"-->
<!--                    android:layout_marginLeft="10dp"-->
<!--                    android:textColor="@color/color_user_main_value"-->
<!--                    android:textSize="14sp" />-->
<!--            </LinearLayout>-->
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:layout_alignParentBottom="true"
            android:id="@+id/bottom_rl">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_title"
                    android:textSize="14sp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:text="@string/pipe_main_linuxstatus" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="5dp"
                    android:textColor="@color/content_title"
                    android:textSize="14sp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    app:stringStatus="@{model.linuxStatus}" />
            </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_title"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentLeft="true"
                        android:text="@string/pipe_main_status" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:textColor="@color/content_title"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        app:stringStatus="@{model.status}" />
                </LinearLayout>
        </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="30dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_title"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentLeft="true"
                        android:text="@string/pipe_main_connect" />

                    <com.gidi.bio_pcr.view.CustomView
                        android:layout_marginLeft="5dp"
                        android:layout_gravity="center_vertical"
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        app:booleanToImg="@{model.connect}"/> />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/content_title"
                        android:textSize="14sp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentLeft="true"
                        android:text="@string/exist_check" />

                    <com.gidi.bio_pcr.view.CustomView
                        android:layout_marginLeft="5dp"
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        app:existImg="@{model.exist}"/> />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>


</LinearLayout>
</layout>