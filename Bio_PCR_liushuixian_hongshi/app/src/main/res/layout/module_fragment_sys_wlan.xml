<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    <RelativeLayout
        android:id="@+id/wlan_state_layout"
        android:layout_width="fill_parent"
        android:layout_height="64dp"
        android:background="@color/white">
        <TextView
            android:id="@+id/wlan_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="8dp"
            android:gravity="center"
            android:text="@string/wlan_close"
            android:textSize="20sp"
            android:textColor="@color/black"/>
        <TextView
            android:id="@+id/connect_status_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/wlan_txt"
            android:layout_marginLeft="12dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textColor="@color/blue"/>

        <ImageView
            android:id="@+id/wifi_control_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="24dp"
            android:src="@drawable/icon_wifi_off"/>
    </RelativeLayout>
    <View
        android:id="@+id/horizontal_line_text"
        style="@style/horizontal_line"
        android:layout_below="@id/wlan_state_layout"/>

    <RelativeLayout
        android:id="@+id/wifi_center_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/horizontal_line_text">
        <ListView
            android:id="@+id/wifi_listview"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:divider="@color/color_main_text"
            android:dividerHeight="1dp"
            android:fastScrollEnabled="false"
            android:headerDividersEnabled="true"
            android:scrollingCache="true">
        </ListView>
        <!-- wifi列表 -->
        <TextView
            android:id="@+id/wifi_seaching_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wlan_close_hint"
            android:layout_centerInParent="true"
            android:textSize="16sp"
            android:textColor="@color/deep_gray" />
    </RelativeLayout>
</RelativeLayout>