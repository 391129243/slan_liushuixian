<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:custom="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.UserLoginViewModel" />
    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
<!--        android:background="@drawable/user_main_bg_2"-->
        <View
            android:id="@+id/untouchview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:background="#50000000">
        </View>
        <RelativeLayout
            android:layout_width="500dp"
            android:layout_height="500dp"
            tools:context="com.paul.pipeline.fragment.UserLoginFragment"
            android:background="@drawable/selector_tray_unused"
            android:layout_centerInParent="true">
            <RelativeLayout
                android:layout_width="450dp"
                android:layout_height="480dp"
                android:layout_centerInParent="true"
                android:background="@color/white"
                android:padding="48dp">

                <TextView
                    android:id="@+id/title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:text="@string/homepage_welocome_login"
                    android:textColor="#5675BF"
                    android:textSize="@dimen/font_size_large_24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/account_layout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/title_tv"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="52dp"
                    android:layout_marginRight="8dp"
                    android:orientation="horizontal"
                    android:background="#E0E0E0">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:gravity="center"
                        android:src="@drawable/icon_login_account"/>
                    <TextView
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#8F8C8C"/>
<!--                    <com.paul.pipeline.view.keyboard.IEditText-->
                    <com.gidi.bio_pcr.view.SystemKeyBoardEditText
                        android:id="@+id/login_account_et"
                        android:layout_height="match_parent"
                        android:layout_width="match_parent"
                        android:gravity="center_vertical"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp"
                        android:paddingLeft="8dp"
                        android:digits="qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM1234567890"
                        android:maxLength="20"
                        android:singleLine="true"
                        android:textColor="@color/color_login_value"
                        android:textColorHint="@color/color_login_hint"
                        android:hint="@string/homepage_login_account_hint"
                        android:text="User"
                        android:textSize="16sp"
                        android:background="@null"
                        custom:outSideCancel="true"
                        custom:keyDrawable="@drawable/btn_keyboard_key"
                        custom:xmlLayoutResId="@xml/keyboard_abc"/>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_below="@id/account_layout"
                    android:layout_marginLeft="8dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginRight="8dp"
                    android:orientation="horizontal"
                    android:background="#E0E0E0">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:gravity="center"
                        android:src="@drawable/icon_login_password"/>
                    <TextView
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="#8F8C8C"/>
                    <!-- 密码 -->
                    <com.gidi.bio_pcr.view.SystemKeyBoardEditText
                        android:id="@+id/login_pwd_et"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingLeft="8dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="2dp"
                        android:enabled="true"
                        android:inputType="numberPassword"
                        android:maxLength="20"
                        android:singleLine="true"
                        android:textColor="@color/color_login_value"
                        android:textColorHint="@color/color_login_hint"
                        android:hint="@string/homepage_login_password_hint"
                        android:text="101010"
                        android:background="@null"
                        custom:outSideCancel="true"
                        custom:keyDrawable="@drawable/btn_keyboard_key"
                        custom:xmlLayoutResId="@xml/keyboard_numbers"/>
                </LinearLayout>

                <Button
                    android:id="@+id/user_login_btn"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_below="@id/password_layout"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="52dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/selector_btn_login"
                    android:gravity="center"
                    android:text="@string/login"
                    android:textColor="@color/white"
                    android:textSize="20sp" />
            </RelativeLayout>
        </RelativeLayout>
        <com.paul.pipeline.view.keyboard.IKeyboardView
            android:id="@+id/keyboardview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:visibility="gone"/>
    </RelativeLayout>
</layout>
