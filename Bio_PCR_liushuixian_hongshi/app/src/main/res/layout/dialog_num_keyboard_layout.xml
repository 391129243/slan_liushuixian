<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="500dp"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:alpha="0.8"
        android:background="@color/white">
        <EditText
            android:id="@+id/dialog_keyboard_et"
            android:layout_width="240dp"
            android:layout_height="46dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="false"
            android:enabled="false"
            android:focusable="false"
            android:background="@drawable/shape_rect_stoke"/>
           
        <TextView
            android:id="@+id/dialog_keyboard_cancel_btn"
            android:layout_width="120dp"
            android:layout_height="46dp"
            android:layout_alignParentRight="true"
            android:text="@string/dialog_cancel"
            android:textColor="@color/white"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:background="@drawable/shape_btn_common_blue"/>
        
        <com.gidi.bio_pcr.view.NumKeyboard
            android:id="@+id/dialog_numkeyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/dialog_keyboard_et"
            android:layout_marginTop="12dp"/>
    </RelativeLayout>
</FrameLayout>