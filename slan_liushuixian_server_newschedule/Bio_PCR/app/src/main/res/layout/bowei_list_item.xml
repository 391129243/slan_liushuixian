    android:layout_height="50dp">
        <TextView
            android:id="@+id/fam"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_width="100dp"
            android:textSize="10sp"
            android:layout_height="50dp"/>

        <TextView
            android:id="@+id/hex"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_width="100dp"
            android:textSize="10sp"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/rox"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_width="100dp"
            android:textSize="10sp"
            android:layout_height="wrap_content"/>
        <TextView
            android:id="@+id/cy5"
            android:gravity="center"
            android:textColor="@color/black"
            android:layout_width="100dp"
            android:textSize="10sp"
            android:layout_height="wrap_content"/>
</LinearLayout>