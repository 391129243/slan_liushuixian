<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto">
    <data>
<!--        <variable-->
<!--            name="viewModel"-->
<!--            type="com.paul.pipeline.viewmodel.PipeMainViewModel" />-->
    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/user_main_bg_2">

        <RelativeLayout
            android:id="@+id/title_rl"
            android:layout_width="match_parent"
            android:layout_height="68dp">
            <!--显示时间-->
            <com.gidi.bio_pcr.view.DateTimeView
                android:id="@+id/running_time_ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentRight="true"
                android:layout_marginRight="8dp"
                custom:title_text_color="@color/black"
                custom:content_text_color="@color/black">
            </com.gidi.bio_pcr.view.DateTimeView>

            <LinearLayout
                android:id="@+id/ll_btncmd"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@id/running_time_ll"
                android:orientation="horizontal"
                android:paddingTop="3dp">

                <ImageView
                    android:id="@+id/pcr_sound_tv"
                    android:layout_width="wrap_content"
                    android:padding="14dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_no_mute"
                    android:background="@drawable/shape_oval_user_top_bg"
                    android:contentDescription="@null"/>

            <ImageView
                android:id="@+id/opendoor_img"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:padding="14dp"
                android:layout_marginLeft="40dp"
                android:layout_centerVertical="true"
                android:src="@drawable/opendoor_56"
                android:background="@drawable/shape_oval_user_top_bg"
                android:contentDescription="@null"/>

                <ImageView
                    android:id="@+id/selfcheck_tv"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:padding="14dp"
                    android:layout_marginLeft="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_reflesh_no"
                    android:background="@drawable/shape_oval_user_top_bg"
                    android:contentDescription="@null"/>

                <ImageView
                    android:id="@+id/pcr_records_tv"
                    android:layout_width="wrap_content"
                    android:padding="14dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_top_records"
                    android:background="@drawable/shape_oval_user_top_bg"
                    android:contentDescription="@null"/>

                <ImageView
                    android:id="@+id/setting_iv"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:padding="14dp"
                    android:layout_marginLeft="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_system"
                    android:background="@drawable/shape_oval_user_top_bg"
                    android:contentDescription="@null"/>

                <ImageView
                    android:id="@+id/main_back_iv"
                    android:layout_width="wrap_content"
                    android:padding="14dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_main"
                    android:background="@drawable/shape_oval_user_top_bg"
                    android:contentDescription="@null"/>

                <ImageView
                    android:id="@+id/stop_img"
                    android:layout_width="66dp"
                    android:layout_height="66dp"
                    android:padding="14dp"
                    android:layout_marginLeft="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/icon_stop"
                    android:background="@drawable/shape_oval_user_top_bg"
                    android:contentDescription="@null"/>

            <!--截图，在出现结果后在出现-->
<!--            <ImageView-->
<!--                android:id="@+id/sceentshot_tv"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:padding="14dp"-->
<!--                android:layout_marginLeft="40dp"-->
<!--                android:layout_centerVertical="true"-->
<!--                android:src="@drawable/icon_screenshot"-->
<!--                android:background="@drawable/shape_oval_user_top_bg"-->
<!--                android:contentDescription="@null"/>-->

            </LinearLayout>
            <!---报警信息-->
            <LinearLayout
                android:id="@+id/ll_alarm"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@id/ll_btncmd"
                android:layout_alignParentLeft="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="invisible">
                <ImageView
                    android:id="@+id/counting_alarm_img"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_counting_alarm"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:contentDescription="@null"/>
                <TextView
                    android:id="@+id/alarm_msg_title"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:textColor="@color/red"
                    android:layout_marginLeft="30dp"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:text="@string/top_bar_alarm_msg"
                    />
                <TextView
                    android:id="@+id/alarm_msg_tv"
                    android:layout_width="500dp"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:gravity="center_vertical"
                    android:textColor="@color/red"
                    android:layout_marginLeft="10dp"
                    android:textSize="20sp" />

            </LinearLayout>
        </RelativeLayout>

        <androidx.fragment.app.FragmentContainerView
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/fragment_container_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/title_rl"/>

    </RelativeLayout>

</layout>
