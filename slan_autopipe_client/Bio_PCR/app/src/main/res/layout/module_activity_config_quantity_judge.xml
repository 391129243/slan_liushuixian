<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    <!--判别文件-->

    <!--标题-->
    <include
        android:id="@+id/judge_quantity_title_layout"
        layout="@layout/include_common_title_layout"/>
    <!--显示列表-->
    <RelativeLayout
        android:id="@+id/config_judge_list"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:layout_below="@id/judge_quantity_title_layout"
        android:orientation="vertical"
        android:background="@drawable/shape_rect_white_bg">
        <TextView
            android:id="@+id/show_cn_list_title"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="@string/judge_peak_file_list"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_large_20sp"
            android:background="@drawable/shape_rect_blue_2_corners"/>

        <RelativeLayout
            android:id="@+id/edit_cn_list_layout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true">
            <TextView
                android:id="@+id/judge_cn_delete_tv"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/delete"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/color_white_blue_selector"
                android:background="@drawable/selector_general_btn_bg"/>
            <TextView
                android:id="@+id/judge_cn_edit_tv"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:padding="8dp"
                android:text="@string/edit"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/color_white_blue_selector"
                android:background="@drawable/selector_general_btn_bg"/>
        </RelativeLayout>
        <!--列表-->
        <!--列表-->
        <ListView
            android:id="@+id/judge_peak_show_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/show_cn_list_title"
            android:layout_above="@id/edit_cn_list_layout"
            android:divider="@color/blue"
            android:dividerHeight="1dp"/>
    </RelativeLayout>



    <RelativeLayout
        android:id="@+id/config_judge_cn_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/judge_quantity_title_layout"
        android:layout_toRightOf="@id/config_judge_list"
        android:layout_margin="12dp"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/layout_add_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_hex_file_name"
                android:padding="8dp"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/blue" />
            <EditText
                android:id="@+id/quantity_judge_filename_et"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:layout_marginLeft="12dp"
                android:background="@drawable/shape_rect_stoke"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:text="quantity-"
                android:inputType="none"/>
            <TextView
                android:id="@+id/add_cn_tv"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:text="@string/add"
                android:padding="8dp"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/color_white_blue_selector"
                android:background="@drawable/selector_general_btn_bg"/>

            <TextView
                android:id="@+id/delete_cn_tv"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:text="@string/delete"
                android:padding="8dp"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/color_white_blue_selector"
                android:background="@drawable/selector_general_btn_bg"/>
            <TextView
                android:id="@+id/save_cn_tv"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:text="@string/save"
                android:padding="8dp"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/color_white_blue_selector"
                android:background="@drawable/selector_general_btn_bg"/>
        </LinearLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/create_cn_list_title"
            android:layout_below="@id/layout_add_delete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal">
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="选择"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/judge_quantity_sampletype"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/well_detail_pdf_report_target_name"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/judge_quantity_num"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/judge_quantity_comparison_symbol"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/judge_quantity_data_type"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/judge_quantity_comparison_symbol"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/judge_quantity_num"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="3"
                    android:text="@string/judge_quantity_conclusion"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue"/>

        </androidx.appcompat.widget.LinearLayoutCompat>
        <!--多重判别文件详情-->
        <ListView
            android:id="@+id/create_cn_list_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@color/blue"
            android:dividerHeight="1dp"
            android:layout_below="@id/create_cn_list_title"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/create_cn_list_detail"
            android:background="@color/blue"/>
    </RelativeLayout>

</RelativeLayout>