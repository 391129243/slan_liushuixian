<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="324dp"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:background="@color/color_recycle">
    <!--熔解程序段的底部-->
    <TextView
        android:id="@+id/melt_section_scanmode_tv"
        android:layout_width="92dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Step"
        android:textSize="@dimen/font_size_normal_17sp"
        android:textColor="@color/color_dialog_btn_selector"/>
    <!--升温速率-->
    <LinearLayout
        android:id="@+id/melt_section_buttom_continue_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/melt_section_scanmode_tv"
        android:layout_marginLeft="2dp"
        android:visibility="gone"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/white"
            android:text="@string/ruuning_pcr_rate"/>

        <TextView
            android:id="@+id/melt_section_rate_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="0.03"
            android:textColor="@color/color_dialog_btn_selector"
            android:textSize="@dimen/font_size_normal_18sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="℃/s"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_normal_18sp"/>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/melt_section_buttom_step_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/melt_section_scanmode_tv"
        android:layout_marginLeft="2dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/melt_step_interval_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/white"
                android:text="@string/ruuning_pcr_interval"/>

            <TextView
                android:id="@+id/melt_section_interval_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="0.03"
                android:textColor="@color/color_dialog_btn_selector"
                android:textSize="@dimen/font_size_normal_18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:text="℃"
                android:textColor="@color/white"
                android:textSize="@dimen/font_size_normal_18sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/melt_section_interval_holdtime_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:text="@string/ruuning_pcr_melt_holdtime"
                android:textColor="@color/white"
                android:textSize="@dimen/font_size_small_14sp"/>
            <TextView
                android:id="@+id/melt_section_holdtime_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="4dp"
                android:text="10"
                android:textColor="@color/color_dialog_btn_selector"
                android:textSize="@dimen/font_size_normal_18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="1dp"
                android:text="s"
                android:textColor="@color/white"
                android:textSize="@dimen/font_size_normal_18sp"/>
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>