<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/item_file_rootlayout"
    android:gravity="center_vertical"
    android:background="@drawable/shape_item_list_normal"
    android:padding="12dp">
    <ImageView
        android:id="@+id/file_icon_iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/icon_config_dir"/>
    <TextView
        android:id="@+id/file_name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:textSize="@dimen/font_size_normal_18sp"
        android:textColor="@color/color_item_list_text_normal"/>
</LinearLayout>