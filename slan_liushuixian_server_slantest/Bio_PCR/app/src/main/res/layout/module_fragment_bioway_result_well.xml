<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <RelativeLayout
        android:id="@+id/result_bioway_search_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/common_main_content_bg"
        android:padding="8dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp">
        <TextView
            style="@style/style_result_search_title"
            android:id="@+id/result_bioway_search_regent_title"
            android:layout_width="112dp"
            android:layout_centerVertical="true"
            android:layout_marginRight="2dp"
            android:textColor="@color/white"
            android:text="@string/result_reagent" />
        <com.gidi.bio_pcr.view.SystemKeyBoardEditText
            android:id="@+id/result_bioway_search_regent_et"
            android:layout_width="180dp"
            android:layout_height="36dp"
            android:layout_toRightOf="@id/result_bioway_search_regent_title"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_system_rb_bg_pressed"
            android:maxLength="16"
            android:gravity="center"
            android:inputType="number"
            android:background="@drawable/shape_rect_stoke"
            custom:outSideCancel="true"
            custom:keyDrawable="@drawable/btn_keyboard_key"
            custom:xmlLayoutResId="@xml/keyboard_numbers"
            custom:isRandom="false"/>


        <!--身份证-->
        <TextView
            style="@style/style_result_search_title"
            android:id="@+id/result_bioway_search_idcard_title"
            android:layout_toRightOf="@id/result_bioway_search_regent_et"
            android:layout_marginLeft="60dp"
            android:layout_marginRight="2dp"
            android:textColor="@color/white"
            android:layout_centerVertical="true"
            android:text="@string/result_idcard" />
        <com.gidi.bio_pcr.view.SystemKeyBoardEditText
            android:id="@+id/result_bioway_search_idcard_et"
            android:layout_width="260dp"
            android:layout_height="36dp"
            android:layout_toRightOf="@id/result_bioway_search_idcard_title"
            android:textSize="@dimen/font_size_normal_16sp"
            android:textColor="@color/color_system_rb_bg_pressed"
            android:maxLength="20"
            android:gravity="center"
            android:inputType="number"
            android:background="@drawable/shape_rect_stoke"
            custom:outSideCancel="true"
            custom:keyDrawable="@drawable/btn_keyboard_key"
            custom:xmlLayoutResId="@xml/keyboard_numbers"
            custom:isRandom="false"/>

    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/result_bioway_search_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:layout_marginRight="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/common_main_content_bg"
        android:layout_below="@+id/result_bioway_search_layout">

        <TextView
            style="@style/style_result_search_title"
            android:id="@+id/result_bioway_search_testtime_title"
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:text="@string/result_time" />

        <TextView
            android:id="@+id/result_bioway_search_time_tv"
            android:layout_width="180dp"
            android:layout_height="36dp"
            android:layout_toRightOf="@id/result_bioway_search_testtime_title"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/white"
            android:layout_marginLeft="2dp"
            android:maxLength="16"
            android:gravity="center" />
        <ImageView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:id="@+id/result_bioway_time_arrow_img"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/result_bioway_search_time_tv"
            android:src="@drawable/selector_arrow_bg"
            android:contentDescription="@null"/>

        <ImageView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:id="@+id/result_bioway_time_clear_img"
            android:layout_marginLeft="10dp"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/result_bioway_time_arrow_img"
            android:src="@drawable/clear"
            android:contentDescription="@null"/>

        <TextView
            style="@style/style_result_search_title"
            android:id="@+id/result_bioway_search_testitem_title"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/result_bioway_time_clear_img"
            android:layout_marginLeft="20dp"
            android:textColor="@color/white"
            android:text="@string/result_testitem" />
        <TextView
            android:id="@+id/result_bioway_search_item_tv"
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:layout_toRightOf="@id/result_bioway_search_testitem_title"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/white"
            android:gravity="center" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:id="@+id/result_bioway_item_arrow_img"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/result_bioway_search_item_tv"
            android:src="@drawable/selector_arrow_bg"
            android:contentDescription="@null"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:id="@+id/result_bioway_item_clear_img"
            android:layout_marginLeft="10dp"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@id/result_bioway_item_arrow_img"
            android:src="@drawable/clear"
            android:contentDescription="@null"/>
        <Button
            android:id="@+id/result_bioway_search_btn"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:layout_alignParentRight="true"
            android:layout_marginRight="36dp"
            android:text="@string/result_search"
            android:textSize="@dimen/font_size_normal_16sp"
            android:textColor="@color/white"
            android:background="@drawable/selector_general_btn_bg"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/result_bioway_list_title_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/blue"
        android:layout_below="@id/result_bioway_search_btn_layout">
        <TextView
            android:id="@+id/item_bioway_list_result_title_num"
            style="@style/style_result_item_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/result_num"/>
        <TextView
            android:id="@+id/item_bioway_list_result_title_regent"
            style="@style/style_result_item_title"
            android:text="@string/result_reagent"
            android:layout_width="0dp"
            android:layout_weight="5" />
        <TextView
            android:id="@+id/item_bioway_list_result_title_batchCode"
            style="@style/style_result_item_title"
            android:text="@string/result_time"
            android:layout_width="0dp"
            android:layout_weight="4" />
        <TextView
            android:id="@+id/item_bioway_list_result_title_idcard"
            android:layout_centerVertical="true"
            style="@style/style_result_item_title"
            android:text="@string/result_idcard"
            android:layout_width="0dp"
            android:layout_weight="5" />
        <TextView
            android:id="@+id/item_bioway_list_result_title_testitem"
            style="@style/style_result_item_title"
            android:layout_centerVertical="true"
            android:text="@string/result_testitem"
            android:layout_width="0dp"
            android:layout_weight="5" />
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/result_bioway_buttom_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="@color/color_bioway_top_bar_bg"
        android:padding="6dp"
        android:orientation="horizontal">
        <!--首页-->
        <TextView
            android:id="@+id/result_bioway_list_first_tv"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/top_page"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_blue_odd_selector"
            android:background="@drawable/shape_rect_stoke"/>
        <TextView
            android:id="@+id/result_bioway_list_prepage_tv"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="36dp"
            android:gravity="center"
            android:text="@string/pre_page"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_blue_odd_selector"
            android:background="@drawable/shape_rect_stoke"/>
        <TextView
            android:id="@+id/result_bioway_list_nextpage_tv"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_marginLeft="36dp"
            android:text="@string/next_page"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_blue_odd_selector"
            android:background="@drawable/shape_rect_stoke"/>
        <TextView
            android:id="@+id/result_bioway_list_lastpage_tv"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="36dp"
            android:gravity="center"
            android:text="@string/end_page"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_blue_odd_selector"
            android:background="@drawable/shape_rect_stoke"/>
        <TextView
            android:id="@+id/result_bioway_list_delete_tv"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="36dp"
            android:gravity="center"
            android:text="@string/delete"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_blue_odd_selector"
            android:background="@drawable/shape_rect_stoke"/>
        <TextView
            android:id="@+id/result_bioway_list_allcheck_tv"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:visibility="invisible"
            android:layout_marginLeft="36dp"
            android:gravity="center"
            android:text="@string/all_check"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_blue_odd_selector"
            android:background="@drawable/shape_rect_stoke"/>
        <TextView
            android:id="@+id/result_bioway_list_cancel_tv"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:visibility="invisible"
            android:layout_marginLeft="36dp"
            android:gravity="center"
            android:text="@string/cancel"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_blue_odd_selector"
            android:background="@drawable/shape_rect_stoke"/>
    </LinearLayout>
    <!--显示结果列表-->
<!--    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/result_slan_list_recycleview"
        android:layout_below="@id/result_slan_list_title_layout"
        android:layout_above="@id/result_slan_buttom_tab_layout"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"/>-->
    <ListView
        android:id="@+id/result_bioway_list_recycleview"
        android:layout_below="@id/result_bioway_list_title_layout"
        android:layout_above="@id/result_bioway_buttom_tab_layout"
        android:dividerHeight="2dp"
        android:divider="@color/light_gray"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"/>
</RelativeLayout>