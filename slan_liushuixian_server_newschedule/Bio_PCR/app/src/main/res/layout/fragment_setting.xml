<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.paul.pipeline.fragment.SettingFragment">

    <data>
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.SettingViewModel" />
    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">
        <LinearLayout
            android:id="@+id/system_info_tab_layout"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/color_bioway_top_bar_bg">
            <LinearLayout
                android:id="@+id/system_setting_tab_device_rb"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_device_info"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/system_info_device"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>
            <LinearLayout
                android:id="@+id/system_setting_tab_general_rb"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_general"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/system_info_general"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>
            <LinearLayout
                android:id="@+id/system_setting_tab_wlan_rb"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_wlan"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/setting_wlan"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>
            <LinearLayout
                android:id="@+id/system_setting_tab_system_rb"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_system"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/system_info_setting"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>

            <LinearLayout
                android:id="@+id/system_info_tab_filebrowser_rb"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_file_operation"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/setting_change_file_info"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                android:visibility="gone"
                style="@style/horizontal_line"/>

            <LinearLayout
                android:id="@+id/system_info_export_file_rb"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_setting_export"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/setting_export"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>
            <LinearLayout
                android:id="@+id/system_info_tab_help_rb"
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible"
                android:background="@drawable/selector_info_tab_bg"
                android:padding="8dp">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_sys_help"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:text="@string/setting_help_info"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:textColor="@color/white"/>
            </LinearLayout>
            <TextView
                android:layout_height="2dp"
                android:background="@color/white"
                style="@style/horizontal_line"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/system_info_frame_layout"
            android:layout_toRightOf="@id/system_info_tab_layout"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </FrameLayout>
    </RelativeLayout>
</layout>
