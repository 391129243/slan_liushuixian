<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    <!--判别文件-->

    <!--标题-->
    <include
        android:id="@+id/config_std_title_layout"
        layout="@layout/include_common_title_layout"/>
    <!--显示列表-->
    <RelativeLayout
        android:id="@+id/config_std_list"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:layout_below="@id/config_std_title_layout"
        android:orientation="vertical"
        android:background="@drawable/shape_rect_white_bg">
        <TextView
            android:id="@+id/show_std_list_title"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="@string/config_std_file_list"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_large_20sp"
            android:background="@drawable/shape_rect_blue_2_corners"/>

        <RelativeLayout
            android:id="@+id/edit_std_list_layout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true">
            <TextView
                android:id="@+id/config_std_delete_tv"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="@string/delete"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/color_white_blue_selector"
                android:background="@drawable/selector_general_btn_bg"/>
            <TextView
                android:id="@+id/config_std_edit_tv"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:padding="8dp"
                android:text="@string/edit"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/color_white_blue_selector"
                android:background="@drawable/selector_general_btn_bg"/>
        </RelativeLayout>
        <!--列表-->
        <!--列表-->
        <ListView
            android:id="@+id/config_std_show_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/show_std_list_title"
            android:layout_above="@id/edit_std_list_layout"
            android:divider="@color/blue"
            android:dividerHeight="1dp"/>
    </RelativeLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/config_std_title_layout"
        android:layout_toRightOf="@id/config_std_list"
        android:orientation="vertical"
        android:layout_margin="12dp">

        <TextView
            android:id="@+id/config_std_show_detail_title"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="@string/config_std_preview"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_large_20sp"
            android:background="@drawable/shape_rect_blue_2_corners"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/config_std_project_name_tv"
                android:layout_width="120dp"
                android:layout_height="52dp"
                android:gravity="center_vertical|left"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/blue" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/config_std_rg"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/config_std_num_1_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="1"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_left_rb_bg"/>
            <RadioButton
                android:id="@+id/config_std_num_2_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="2"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/config_std_num_3_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="3"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/config_std_num_4_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="4"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/config_std_num_5_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="5"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/config_std_num_6_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="6"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_right_rb_bg"/>
        </RadioGroup>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/config_std_detail_layout"
            android:visibility="gone">
            <!--显示曲线的-->
            <TextView
                android:id="@+id/config_std_x_tv"
                android:layout_width="30dp"
                android:layout_height="400dp"
                android:text="Ct"
                android:gravity="center"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/config_std_curve_chart"
                android:layout_width="match_parent"
                android:layout_toRightOf="@id/config_std_x_tv"
                android:layout_height="400dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:background="#f3f5f8"/>
            <TextView
                android:id="@+id/config_std_y_tv"
                android:layout_below="@id/config_std_curve_chart"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="Log(Conc)"
                android:gravity="center"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp"/>
            <!--显示曲线的具体内容-->

            <LinearLayout
                android:id="@+id/config_std_chart_params_layout"
                android:layout_width="168dp"
                android:layout_height="102dp"
                android:layout_alignParentRight="true"
                android:layout_marginTop="40dp"
                android:layout_marginRight="40dp"
                android:orientation="vertical"
                android:gravity="left"
                android:padding="5dp"
                android:background="@drawable/shape_rect_stoke">
                <TextView
                    android:id="@+id/config_std_chart_slope_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
                <TextView
                    android:id="@+id/config_std_chart_intercept_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
                <TextView
                    android:id="@+id/config_std_chart_r_value_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
                <TextView
                    android:id="@+id/config_std_chart_efficiency_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>



</RelativeLayout>