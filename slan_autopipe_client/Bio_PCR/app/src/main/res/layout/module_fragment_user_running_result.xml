<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="@color/white"
    xmlns:custom="http://schemas.android.com/apk/res-auto">


    <!--通道-->
    <LinearLayout
        android:id="@+id/running_user_chanel_layout"
        android:layout_width="128dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:padding="2dp"
        android:layout_marginLeft="12dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/running_user_channel_1_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/running_select_channel"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/blue"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/result_user_all_channel_check_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_all_channel_bg"
                custom:content_text="@string/result_all_channel"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/running_user_result_fam_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_fam_bg"
                custom:content_text="FAM"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/running_user_result_hex_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_hex_bg"
                custom:content_text="HEX"/>


            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/running_user_result_rox_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_rox_bg"
                custom:content_text="ROX"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/running_user_result_cy5_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_cy5_bg"
                custom:content_text="CY5"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/running_user_result_quasar_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_quasar_bg"
                custom:content_text="QUASAR"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/running_user_result_atto_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_atto_bg"
                custom:content_text="ATTO"/>

            <TextView
                android:id="@+id/running_user_ex_result_more_tv"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/more"
                android:drawableTop="@drawable/icon_result_more"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/running_user_report_tv"
            android:layout_width="128dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:text="@string/result_report"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_normal_16sp"
            android:visibility="visible"
            android:background="@drawable/selector_rect_blue_recycle"/>

        <TextView
            android:id="@+id/running_user_sec_analyse_tv"
            android:layout_width="128dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:text="@string/second_analyse"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_normal_16sp"
            android:visibility="gone"
            android:background="@drawable/selector_rect_blue_recycle"/>

    </LinearLayout>

    <!--1显示曲线和表格和二次分析-->
    <RelativeLayout
        android:id="@+id/result_user_chart_and_excel_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible"
        android:layout_toRightOf="@id/running_user_chanel_layout">
        <!--曲线名称-->
        <RadioGroup
            android:id="@+id/result_user_curve_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="20dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/result_user_rawcurve_rb"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_virgin" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/result_user_ampcurve_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_amplify" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/result_user_meltcurve_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_melt" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/result_user_peakcurve_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_melt_peak" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/result_user_list_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_excel" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/result_user_set_paramter_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_set_paramter" />
        </RadioGroup>

        <!--孔位-->
        <LinearLayout
            android:id="@+id/result_user_hole_layout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingLeft="36dp"
            android:paddingRight="36dp"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_running_all_hole_ck"
                android:textSize="@dimen/font_size_normal_16sp"
                android:text="@string/result_all_hole_check" />
            <!--A8-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_eight_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_one" />
            <!--A7-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_seven_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_two" />
            <!--A6-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_six_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_three"/>

            <!--A5-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_five_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_four" />

            <!--A4-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_four_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_five" />

            <!--A3-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_three_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_six"/>

            <!--A2-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_two_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_seven"  />

            <!--A1-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/result_user_hole_one_btn"
                android:enabled="false"
                android:layout_marginLeft="54dp"
                android:text="@string/hole_eight" />

        </LinearLayout>
        <!--1-1显示曲线-->
        <LinearLayout
            android:id="@+id/result_user_curve_chart_layout"
            android:layout_width="match_parent"
            android:layout_height="440dp"
            android:padding="4dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="20dp"
            android:layout_below="@id/result_user_curve_layout"
            android:layout_above="@id/result_user_hole_layout"
            android:visibility="gone">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/running_result_user_curve_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:layout_marginTop="10dp"
                android:background="#f3f5f8"/>
        </LinearLayout>

        <!--1-2显示结果表格-->
        <HorizontalScrollView
            android:id="@+id/result_user_excel_list_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_below="@id/result_user_curve_layout"
            android:layout_above="@id/result_user_hole_layout"
            android:padding="4dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/result_user_excel_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!---标题-->
                <include
                    android:id="@+id/resut_user_list_title_layout"
                    layout="@layout/include_result_slan_excel_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp" />
                <ListView
                    android:id="@+id/result_user_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dividerHeight="1dp"
                    android:divider="@color/detect_gray"/>
            </LinearLayout>
        </HorizontalScrollView>

        <!--1-3显示二次分析表格-->
        <!--二次分析的页面-->
        <RelativeLayout
            android:id="@+id/user_result_sec_analyse_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="20dp"
            android:layout_marginLeft="20dp"
            android:visibility="gone"
            android:padding="4dp"
            android:layout_below="@id/result_user_curve_layout"
            android:layout_above="@id/result_user_hole_layout">
            <!--基本参数，熔解曲线参数标题-->
            <LinearLayout
                android:id="@+id/user_result_sec_analyse_param_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/user_result_basic_param_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingRight="6dp"
                    android:paddingLeft="6dp"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:textColor="@color/white"
                    android:text="@string/config_info_basic_parameters"
                    android:background="@drawable/shape_rect_blue"/>
                <TextView
                    android:id="@+id/user_result_melt_param_title_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:gravity="center"
                    android:text="@string/config_info_melt_curve_parameters"
                    android:background="@drawable/shape_rect_blue_stroke"/>
            </LinearLayout>
            <!--扩增曲线算法参数-->
            <LinearLayout
                android:id="@+id/user_result_sec_analyse_amp_param_layout"
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:visibility="visible"
                android:layout_below="@id/user_result_sec_analyse_param_title_layout"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_info_amplification_curve_algorithm"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <TextView
                        android:id="@+id/user_result_sec_analyse_amp_algorithm_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="12dp"
                        android:text="@string/config_info_ampalgorithm_default"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@null"
                        android:src="@drawable/arrow_press" />
                </LinearLayout>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:background="@color/color_recycle">
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_dye_1"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_channel"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_analyse_type"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_begin_baseline"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_end_baseline"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_optimization"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_auto_threshold"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_manual_threshold"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_digital_filter"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
                <ListView
                    android:id="@+id/user_result_sec_analyse_amp_algorithm_lv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dividerHeight="1dp"
                    android:divider="@color/blue"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
            </LinearLayout>
            <!--熔解曲线算法参数-->
            <LinearLayout
                android:id="@+id/user_result_sec_analyse_melt_param_layout"
                android:layout_width="match_parent"
                android:layout_height="310dp"
                android:layout_below="@id/user_result_sec_analyse_param_title_layout"
                android:visibility="gone"
                android:orientation="vertical">


                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@color/color_recycle"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_dye_1"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_channel"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_min_temp"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_max_temp"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_melt_algorithm"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_peak_threshold"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_peak_type"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
                <!--熔解曲线参数-->
                <ListView
                    android:id="@+id/user_result_sec_analyse_melt_paramter_lv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dividerHeight="1dp"
                    android:divider="@color/blue"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>





    <!--检验报告-->

    <RelativeLayout
        android:id="@+id/running_user_result_show_report_rl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/running_user_chanel_layout"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/user_result_report_scan_layout"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_alignParentBottom="true"
            android:background="#F5F5F5">
            <!--打印当前报告-->
            <RadioGroup
                android:id="@+id/result_user_report_hole_rg"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentBottom="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <!--A8-->
                <RadioButton
                    style="@style/style_user_result_report_radiobtn"
                    android:id="@+id/result_user_report_hole_eight_btn"
                    android:layout_marginLeft="32dp"
                    android:enabled="false"
                    android:text="@string/hole_one" />

                <!--A7-->
                <RadioButton
                    style="@style/style_user_result_report_radiobtn"
                    android:id="@+id/result_user_report_hole_seven_btn"
                    android:layout_marginLeft="32dp"
                    android:enabled="false"
                    android:text="@string/hole_two" />

                <!--A6-->
                <RadioButton
                    style="@style/style_user_result_report_radiobtn"
                    android:id="@+id/result_user_report_hole_six_btn"
                    android:layout_marginLeft="32dp"
                    android:enabled="false"
                    android:text="@string/hole_three"  />

                <!--A5-->
                <RadioButton
                    style="@style/style_user_result_report_radiobtn"
                    android:id="@+id/result_user_report_hole_five_btn"
                    android:layout_marginLeft="32dp"
                    android:enabled="false"
                    android:text="@string/hole_four"  />
                <!--A4-->
                <RadioButton
                    style="@style/style_user_result_report_radiobtn"
                    android:id="@+id/result_user_report_hole_four_btn"
                    android:layout_marginLeft="32dp"
                    android:enabled="false"
                    android:text="@string/hole_five" />

                <!--A3-->
                <RadioButton
                    style="@style/style_user_result_report_radiobtn"
