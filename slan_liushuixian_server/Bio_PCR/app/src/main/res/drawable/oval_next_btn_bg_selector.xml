<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
	<item android:state_pressed="false">
	    <shape
	        android:shape="oval">
	        <gradient 
	        android:angle="0"
	        android:startColor="#F5F5F5"
	        android:endColor="@color/white"/>
	    <stroke 
	        android:color="#2CA8FF"
	        android:width="1dp"/>
	     </shape>	     
	 </item>
	<item android:state_enabled="false">
		<shape
			android:shape="oval">
			<gradient
				android:angle="0"
				android:startColor="#F5F5F5"
				android:endColor="@color/white"/>
			<stroke
				android:color="#2CA8FF"
				android:width="1dp"/>
		</shape>
	</item>
	<item android:state_pressed="true">
	    <shape
	        android:shape="oval">
    	<solid
       	 	android:angle="0"
        	android:color="@color/color_bioway_top_bar_bg"/>
    	<stroke 
        	android:color="#2CA8FF"
        	android:width="1dp"/>
	     </shape>	     
	 </item>

	<item android:state_enabled="true">
		<shape
			android:shape="oval">
			<solid
				android:angle="0"
				android:color="@color/color_bioway_top_bar_bg"/>
			<stroke
				android:color="#2CA8FF"
				android:width="1dp"/>
		</shape>
	</item>
</selector>
