<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/dialog_layout_accout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dialog_account_title"
            android:layout_width="103dp"
            android:gravity="center"
            android:layout_height="match_parent"
            android:textColor="@color/black"
            android:textSize="@dimen/font_size_large_20sp"
            android:text="@string/login_account" />

        <EditText
            android:id="@+id/dialog_account_et"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="2dp"
            android:maxLength="20"
            android:enabled="false"
            android:singleLine="true"
            android:paddingLeft="8dp"
            android:gravity="center_vertical"
            android:textSize="@dimen/font_size_large_20sp"
            android:textColor="@color/black"
            android:background="@drawable/shape_rect_blue_stroke"
            android:text="User"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_password"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical"
        android:layout_below="@id/dialog_layout_accout"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/dialog_password_tv"
            android:layout_width="103dp"
            android:layout_height="match_parent"
            android:textColor="@color/black"
            android:gravity="center"
            android:textSize="@dimen/font_size_large_20sp"
            android:text="@string/login_password" />
        <!-- 密码 -->
        <EditText
            android:id="@+id/dialog_password_et"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="numberPassword"
            android:paddingLeft="4dp"
            android:layout_marginLeft="2dp"
            android:singleLine="true"
            android:gravity="center_vertical"
            android:textSize="@dimen/font_size_large_20sp"
            android:textColor="@color/black"
            android:background="@drawable/shape_rect_blue_stroke"
            android:maxLength="10"
            android:text="101010"/>
    </LinearLayout>
</RelativeLayout>