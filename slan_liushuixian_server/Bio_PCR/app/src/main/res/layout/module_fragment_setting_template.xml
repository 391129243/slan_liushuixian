<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:custom="http://schemas.android.com/apk/res-auto">

    <!--显示删除和复制按钮-->
    <RelativeLayout
        android:id="@+id/template_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        >
        <com.gidi.bio_pcr.view.CustomTitleText
            android:id="@+id/template_copy_progress_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            custom:title_text_color="@color/blue"
            custom:title_text="@string/setting_template_copy_progress"/>
        <TextView
            android:id="@+id/template_create_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:gravity="center"
            android:text="创建模板"
            android:textColor="@color/color_dialog_btn_selector"
            android:textSize="@dimen/font_size_large_20sp"
            android:background="@drawable/dialog_ok_btn_bg"/>
        <TextView
            android:id="@+id/template_export_tv"
            android:layout_toLeftOf="@id/template_create_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginRight="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:gravity="center"
            android:text="导出模板"
            android:textColor="@color/color_dialog_btn_selector"
            android:textSize="@dimen/font_size_large_20sp"
            android:background="@drawable/dialog_ok_btn_bg"/>

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/template_setting_buttom_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_alignParentBottom="true"
        android:padding="12dp"
        >
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/template_udisk_state"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"/>
        <TextView
            android:id="@+id/template_usb_state_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"/>
    </LinearLayout>
    <View
        android:id="@+id/btn_devider_line"
        style="@style/horizontal_line"
        android:layout_below="@id/template_btn_layout"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btn_devider_line"
        android:layout_above="@id/template_setting_buttom_layout">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_margin="12dp"
            android:padding="12dp"
            android:orientation="vertical"
            android:layout_height="match_parent"
            android:background="@color/color_landscape_main_center">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_template_in_udisk"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_large_20sp"/>
                <TextView
                    android:id="@+id/usb_temp_back_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:text="@string/setting_template_back"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_large_20sp"/>
            </RelativeLayout>


            <ListView
                android:id="@+id/template_udisk_lv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dividerHeight="3dp"
                android:layout_marginTop="18sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_margin="12dp"
            android:padding="12dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/color_landscape_main_center">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_template_in_local"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_large_20sp"/>
                <TextView
                    android:id="@+id/local_temp_back_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:text="@string/setting_template_back"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_large_20sp"/>
            </RelativeLayout>

            <ListView
                android:id="@+id/template_local_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:dividerHeight="3dp"
                android:layout_marginTop="18sp"
                />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>