<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:background="@color/white">

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_paramter_dye_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_channel_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="1"
            android:textColor="@color/black"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_enable_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_enhance_lower_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_enhance_upper_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_enhance_gain_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_weaken_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_weaken_gain_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_peak_optimize_slope_thres_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
</androidx.appcompat.widget.LinearLayoutCompat>