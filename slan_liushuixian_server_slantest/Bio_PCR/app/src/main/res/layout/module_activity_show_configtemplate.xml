<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <!--标题-->
    <include
        android:id="@+id/show_config_template_title_layout"
        layout="@layout/include_common_title_layout"/>

    <LinearLayout
        android:id="@+id/show_config_tab_layout"
        android:layout_width="266dp"
        android:layout_below="@id/show_config_template_title_layout"
        android:padding="15dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:background="@color/white"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/show_config_tab_full_process_tv"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="60dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_config_left_tab_press">
            <ImageView
                android:id="@+id/config_tab_fullprocee_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_config_fullprocee_press"
                android:contentDescription="@null"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/show_config_full_process"
                android:layout_marginLeft="5dp"
                android:textSize="@dimen/font_size_large_24sp"
                android:textColor="@color/main_tab_color" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/show_config_tab_hex_tv"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="60dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_config_left_tab_normal">
            <ImageView
                android:id="@+id/config_tab_hex_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_config_rna_normal"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/show_config_single_rna"
                android:layout_marginLeft="5dp"
                android:textSize="@dimen/font_size_large_24sp"
                android:textColor="@color/color_config_left_normal_text"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/show_config_tab_pcr_tv"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="60dp"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_config_left_tab_normal">
            <ImageView
                android:id="@+id/config_tab_pcr_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_config_pcr_normal"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/show_config_single_pcr"
                android:layout_marginLeft="5dp"
                android:textSize="@dimen/font_size_large_24sp"
                android:textColor="@color/color_config_left_normal_text"/>
        </LinearLayout>
    </LinearLayout>
    <!--end左边的tab-->

    <RelativeLayout
        android:id="@+id/show_config_full_procee_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/show_config_template_title_layout"
        android:layout_toRightOf="@id/show_config_tab_layout"
        android:visibility="visible"
        android:background="@color/config_left_bg">
        <RelativeLayout
            android:id="@+id/show_fullproc_ctrl_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="#A7C7F1">
            <TextView
                style="@style/style_config_ctrl_tab_tv"
                android:id="@+id/show_export_formal_template_tv"
                android:layout_width="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_centerVertical="true"
                android:text="@string/show_config_export_template"
                android:drawableLeft="@drawable/icon_config_export"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>

            <TextView
                android:id="@+id/show_config_edit_delete_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_toRightOf="@id/show_export_formal_template_tv"
                android:layout_centerVertical="true"
                android:layout_marginLeft="22dp"
                android:text="@string/show_config_delete_template"
                android:drawableLeft="@drawable/icon_config_delete"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>

            <TextView
                android:id="@+id/show_config_edit_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_toRightOf="@id/show_config_edit_delete_tv"
                android:layout_centerVertical="true"
                android:layout_marginLeft="22dp"
                android:text="@string/show_config_edit_template"
                android:drawableLeft="@drawable/icon_config_load"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>

            <TextView
                android:id="@+id/show_create_multi_template_tv"
                android:layout_toRightOf="@id/show_config_edit_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="22dp"
                android:text="@string/show_config_create_multi_template"
                android:drawableLeft="@drawable/icon_config_multi"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
            <TextView
                android:id="@+id/show_create_single_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toRightOf="@id/show_create_multi_template_tv"
                android:layout_marginLeft="22dp"
                android:text="@string/show_config_create_single_template"
                android:drawableLeft="@drawable/icon_config_single"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
        </RelativeLayout>
        <LinearLayout
            android:id="@+id/show_all_template_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:layout_below="@id/show_fullproc_ctrl_btn_layout"
            android:orientation="horizontal">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginRight="10dp"
                android:layout_marginLeft="12dp"
                android:orientation="vertical"
                android:layout_height="match_parent"
                android:background="@drawable/shape_rect_common_list">
                <RelativeLayout
                    android:id="@+id/show_config_temp_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/shape_rect_blue_2_corners">

                    <TextView
                        android:id="@+id/show_config_temp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:text="@string/show_config_templete_config_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/font_size_large_22sp" />
                    <TextView
                        android:id="@+id/show_config_temp_back_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_alignParentRight="true"
                        android:text="@string/setting_template_back"
                        android:textColor="@color/color_config_back"
                        android:textSize="@dimen/font_size_small_14sp"/>
                </RelativeLayout>


                <ListView
                    android:id="@+id/show_config_template_list"
                    android:layout_below="@id/show_config_temp_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:dividerHeight="2dp"
                    android:divider="@color/white"
                    android:padding="12dp"
                    android:background="@drawable/shape_rect_common_list"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginRight="12dp"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/show_config_exported_temp_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/shape_rect_blue_2_corners">

                    <TextView
                        android:id="@+id/show_config_exported_temp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_centerInParent="true"
                        android:background="@color/blue"
                        android:gravity="center"
                        android:text="@string/show_config_templete_export_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/font_size_large_22sp" />
                    <TextView
                        android:id="@+id/show_config_exported_back_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_alignParentRight="true"
                        android:text="@string/setting_template_back"
                        android:textColor="@color/color_config_back"
                        android:textSize="@dimen/font_size_small_14sp"/>
                </RelativeLayout>


                <ListView
                    android:id="@+id/show_export_template_list"
                    android:layout_below="@id/show_config_exported_temp_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:dividerHeight="2dp"
                    android:divider="@color/white"
                    android:padding="12dp"
                    android:background="@drawable/shape_rect_common_list"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>


    <!--显示hexlayout-->
    <RelativeLayout
        android:id="@+id/show_config_rna_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/show_config_template_title_layout"
        android:layout_toRightOf="@id/show_config_tab_layout"
        android:visibility="gone"
        android:background="@color/config_left_bg">
        <RelativeLayout
            android:id="@+id/show_config_hex_ctrl_layout"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="#A7C7F1">
            <TextView
                android:id="@+id/show_config_export_hex_template_tv"
                android:layout_width="168dp"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_centerVertical="true"
                android:layout_marginLeft="22dp"
                android:text="@string/show_config_export_template"
                android:drawableLeft="@drawable/icon_config_export"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
            <TextView
                android:id="@+id/show_config_delete_hex_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_toRightOf="@id/show_config_export_hex_template_tv"
                android:layout_marginLeft="22dp"
                android:layout_centerVertical="true"
                android:text="@string/show_config_delete_template"
                android:drawableLeft="@drawable/icon_config_delete"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
            <TextView
                android:id="@+id/show_config_edit_hex_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_toRightOf="@id/show_config_delete_hex_tv"
                android:layout_marginLeft="22dp"
                android:layout_centerVertical="true"
                android:text="@string/show_config_edit_template"
                android:drawableLeft="@drawable/icon_config_load"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
            <TextView
                android:id="@+id/show_create_hex_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_toRightOf="@id/show_config_edit_hex_template_tv"
                android:layout_centerVertical="true"
                android:layout_marginLeft="22dp"
                android:text="@string/create_single_rna_title"
                android:drawableLeft="@drawable/icon_config_multi"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/show_hex_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/show_config_hex_ctrl_layout"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:orientation="horizontal">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginRight="10dp"
                android:layout_height="match_parent"
                android:background="@drawable/shape_rect_common_list">
                <RelativeLayout
                    android:id="@+id/show_config_hex_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/shape_rect_blue_2_corners">

                    <TextView
                        android:id="@+id/show_config_hex_title"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:text="@string/show_config_rna_templete_config_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/font_size_large_22sp" />
                    <TextView
                        android:id="@+id/show_config_hex_back_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_alignParentRight="true"
                        android:text="@string/setting_template_back"
                        android:textColor="@color/color_config_back"
                        android:textSize="@dimen/font_size_small_14sp"/>
                </RelativeLayout>


                <ListView
                    android:id="@+id/show_config_hex_template_lv"
                    android:layout_below="@id/show_config_hex_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/white"
                    android:dividerHeight="2dp"
                    android:padding="12dp"
                    android:background="@drawable/shape_rect_common_list"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginRight="12dp"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/show_config_exported_hex_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/shape_rect_blue_2_corners">

                    <TextView
                        android:id="@+id/show_config_exported_hex_title"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_centerInParent="true"
                        android:background="@color/blue"
                        android:gravity="center"
                        android:text="@string/show_config_rna_templete_export_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/font_size_large_22sp" />
                    <TextView
                        android:id="@+id/show_config_exported_hex_back_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/setting_template_back"
                        android:textColor="@color/color_config_back"
                        android:textSize="@dimen/font_size_small_14sp"/>
                </RelativeLayout>

                <ListView
                    android:id="@+id/show_export_hex_lv"
                    android:layout_below="@id/show_config_exported_hex_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:dividerHeight="2dp"
                    android:divider="@color/white"
                    android:padding="12dp"
                    android:background="@drawable/shape_rect_common_list"/>
            </RelativeLayout>
        </LinearLayout>

    </RelativeLayout>


    <!--显示pcrlayout-->
    <RelativeLayout
        android:id="@+id/show_config_pcr_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/show_config_template_title_layout"
        android:layout_toRightOf="@id/show_config_tab_layout"
        android:visibility="gone"
        android:background="@color/config_left_bg">
        <RelativeLayout
            android:id="@+id/show_pcr_ctrl_btn_layout"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:background="#A7C7F1">
            <TextView
                android:id="@+id/show_config_export_pcr_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="22dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"
                android:drawableLeft="@drawable/icon_config_export"
                android:drawablePadding="2dp"
                android:text="@string/show_config_export_pcr_template" />

            <TextView
                android:id="@+id/show_config_delete_pcr_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_toRightOf="@id/show_config_export_pcr_template_tv"
                android:layout_marginLeft="22dp"
                android:layout_centerVertical="true"
                android:text="@string/show_config_delete_template"
                android:drawableLeft="@drawable/icon_config_delete"
                android:drawablePadding="2dp"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>

            <TextView
                android:id="@+id/show_config_edit_pcr_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_width="wrap_content"
                android:layout_toRightOf="@id/show_config_delete_pcr_tv"
                android:layout_marginLeft="22dp"
                android:layout_centerVertical="true"
                android:text="@string/show_config_edit_template"
                android:drawablePadding="2dp"
                android:drawableLeft="@drawable/icon_config_load"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
            <TextView
                android:id="@+id/show_create_pcr_template_tv"
                style="@style/style_config_ctrl_tab_tv"
                android:layout_toRightOf="@id/show_config_edit_pcr_template_tv"
                android:layout_width="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_centerVertical="true"
                android:drawableLeft="@drawable/icon_config_single"
                android:drawablePadding="2dp"
                android:text="@string/show_config_create_pcr_template"
                android:background="@drawable/shape_config_ctrl_btn_normal_bg"/>
        </RelativeLayout>
        <!--单PCR模板-->
        <LinearLayout
            android:id="@+id/show_pcr_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/show_pcr_ctrl_btn_layout"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:orientation="horizontal">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginRight="10dp"
                android:orientation="vertical"
                android:layout_height="match_parent"
                >
                <RelativeLayout
                    android:id="@+id/show_config_pcr_template_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/shape_rect_blue_2_corners">

                    <TextView
                        android:id="@+id/show_config_pcr_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:background="@color/blue"
                        android:gravity="center"
                        android:text="@string/show_config_pcr_templete_config_title"
                        android:textColor="@color/white"
                        android:textSize="@dimen/font_size_large_22sp" />
                    <TextView
                        android:id="@+id/show_config_pcr_back_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_alignParentRight="true"
                        android:text="@string/setting_template_back"
                        android:textColor="@color/color_config_back"
                        android:textSize="@dimen/font_size_small_14sp"/>
                </RelativeLayout>

                <ListView
                    android:id="@+id/show_config_pcr_template_lv"
                    android:layout_below="@id/show_config_pcr_template_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:divider="@color/white"
                    android:background="@drawable/shape_rect_common_list"
                    android:dividerHeight="2dp"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginRight="12dp"
                android:orientation="vertical"
                android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/show_config_exported_pcr_title_layout"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/shape_rect_blue_2_corners">
                <TextView
                    android:id="@+id/show_config_exported_pcr_title"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/show_config_pcr_templete_export_title"
                    android:layout_centerInParent="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_size_large_22sp"
                    android:background="@color/blue"/>
                <TextView
                    android:id="@+id/show_export_pcr_back_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_alignParentRight="true"
                    android:text="@string/setting_template_back"
                    android:textColor="@color/color_config_back"
                    android:textSize="@dimen/font_size_small_14sp"/>
            </RelativeLayout>
                <ListView
                    android:id="@+id/show_export_pcr_lv"
                    android:layout_below="@id/show_config_exported_pcr_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:divider="@color/white"
                    android:background="@drawable/shape_rect_common_list"
                    android:dividerHeight="2dp"/>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>


</RelativeLayout>