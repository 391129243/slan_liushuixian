            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:textColor="@color/config_hex_normal"
            android:textSize="@dimen/font_size_large_20sp"
            android:textStyle="bold"
            android:text="@string/template_name"/>
        <TextView
            android:id="@+id/slan_info_tempalte_name"
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/slan_info_tempalte_title"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_large_20sp" />

        <RadioGroup
            android:id="@+id/slan_info_mode_rg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:orientation="horizontal">
            <RadioButton
                style="@style/style_user_info_btn"
                android:id="@+id/slan_info_manual_mode_rb"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:gravity="center"
                android:text="@string/entry_info_manual_input" />
            <RadioButton
                style="@style/style_user_info_btn"
                android:id="@+id/slan_info_scan_mode_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_weight="1"
                android:text="@string/entry_info_scan_input" />
        </RadioGroup>
    </RelativeLayout>

