<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
	xmlns:custom="http://schemas.android.com/apk/res-auto">
    <TextView 
        android:id="@+id/custom_edit_title_txt"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_centerVertical="true"
		android:textSize="@dimen/font_size_normal_18sp"
		android:textColor="@color/color_main_text"
		android:text="ROX:" />
	<com.gidi.bio_pcr.view.SystemKeyBoardEditText
		android:id="@+id/custom_edit"
		android:layout_toRightOf="@id/custom_edit_title_txt"
		android:layout_width="78dp"
		android:layout_marginLeft="4dp"
		android:layout_height="38dp"
		android:maxLength="5"
		android:gravity="center"
		android:textColor="@color/blue"
		android:textColorHint="@color/blue"
		android:textSize="@dimen/font_size_normal_18sp"
		android:background="@drawable/shape_rect_stoke"
		custom:outSideCancel="true"
		custom:keyDrawable="@drawable/btn_keyboard_key"
		custom:xmlLayoutResId="@xml/keyboard_numbers"/>
</RelativeLayout>
