                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/pcr_current_circle"
                        android:textColor="@color/color_user_main_text"
                        android:textSize="18sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginLeft="5dp"
                        app:intToString="@{model.currentCircle}"
                        android:textColor="@color/color_user_main_value"
                        android:textSize="18sp" />
