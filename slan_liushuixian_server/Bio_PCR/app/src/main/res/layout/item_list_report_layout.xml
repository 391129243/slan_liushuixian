<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:background="@color/white">
    <ImageView
        android:id="@+id/result_user_hosp_logo_img"
        android:layout_width="480dp"
        android:layout_height="68dp"
        android:contentDescription="@null"
        android:src="@drawable/hosp_1"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/result_user_pdf_report_idcard_img"
                android:layout_width="218dp"
                android:layout_height="48dp"/>

            <TextView
                android:id="@+id/result_user_pdf_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="检验报告单"
                android:textColor="@color/black"
                android:textSize="32sp" />
        </RelativeLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/black"
            android:layout_marginTop="6dp"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp">
        <LinearLayout
            android:id="@+id/pdf_user_result_idcard_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/style_user_result_report_title"
                android:id="@+id/user_result_idcard_title"
                android:text="@string/result_ex_sample_number"
                android:layout_gravity="center_horizontal" />
            <TextView
                style="@style/style_user_result_report_content"
                android:id="@+id/user_result_idcard_tv" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pdf_user_result_testitem_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/pdf_user_result_idcard_layout"
            android:gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:orientation="horizontal">
            <TextView
                style="@style/style_user_result_report_title"
                android:id="@+id/user_result_testitem_title"
                android:text="@string/result_ex_test_item"
                android:layout_gravity="center_horizontal" />
            <TextView
                style="@style/style_user_result_report_content"
                android:id="@+id/user_result_testitem_tv" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pdf_user_result_testtime_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_below="@id/pdf_user_result_idcard_layout"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/style_user_result_report_title"
                android:id="@+id/user_result_testtime_title"
                android:text="@string/result_ex_test_time"
                android:layout_gravity="center_horizontal" />
            <TextView
                style="@style/style_user_result_report_content"
                android:id="@+id/user_result_testtime_tv" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"
        android:layout_marginTop="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#D8D8D8"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            style="@style/style_pdf_item_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:text="N0."
            android:textSize="@dimen/font_size_normal_18sp"/>

        <TextView
            style="@style/style_pdf_item_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:textColor="@color/black"
            android:text="@string/result_ex_item"
            android:textSize="@dimen/font_size_normal_18sp"/>


        <TextView
            style="@style/style_pdf_item_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:textColor="@color/black"
            android:text="@string/create_multi_ctvalue"
            android:textSize="@dimen/font_size_normal_18sp"/>
        <TextView
            android:id="@+id/user_running_results_title"
            style="@style/style_pdf_item_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="@string/result_ex_result"
            android:textSize="@dimen/font_size_normal_18sp"/>

        <TextView
            android:id="@+id/user_running_result_reference_title"
            style="@style/style_pdf_item_title"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="@string/result_ex_reference"
            android:textSize="@dimen/font_size_normal_18sp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"/>
    <!--熔解曲线参数-->
    <ListView
        android:id="@+id/user_result_report_lv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dividerHeight="1dp"
        android:divider="@color/blue"/>
</LinearLayout>