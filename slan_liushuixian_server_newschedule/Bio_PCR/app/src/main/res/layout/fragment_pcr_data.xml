        <HorizontalScrollView
            android:id="@+id/bioway_first_pcr_step_layout"
            android:layout_weight="3.5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:visibility="visible">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/bioway_first_pcr_program_title_layout"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="28dp">

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bioway_first_pcr_program_recycle_layout"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal"
                    >
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bioway_first_pcr_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/bioway_first_pcr_program_title_layout"
                    android:layout_above="@id/bioway_first_pcr_program_recycle_layout"/>
            </RelativeLayout>
        </HorizontalScrollView>
        <LinearLayout
            android:layout_weight="2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
