<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    xmlns:custom="http://schemas.android.com/apk/res-auto">
        <RelativeLayout
            android:id="@+id/login_layout"
            android:layout_width="420dp"
            android:layout_height="240dp"
            android:orientation="vertical"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="200dp">
            <LinearLayout
                android:id="@+id/layout_accout"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginLeft="21dp"
                android:layout_marginRight="21dp"
                android:layout_marginTop="32dp"

                android:orientation="horizontal">
                <TextView
                    android:id="@+id/setting_perfusion_livernum_title"
                    style="@style/style_login_title_txt"
                    android:layout_width="103dp"
                    android:gravity="center"
                    android:textColor="@color/blue"
                    android:layout_height="match_parent"
                    android:text="登录账号" />

                <EditText
                    style="@style/style_pre_setting_iconedit"
                    android:id="@+id/login_info_account_et"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="2dp"
                    android:digits="qwertyuiopasdfghjklzxcvbnmQWERTYUIOPASDFGHJKLZXCVBNM1234567890"
                    android:maxLength="20"
                    android:singleLine="true"
                    android:inputType="text"
                    android:textColor="@color/blue"
                    android:background="@drawable/shape_rect_stoke"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/layout_password"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginLeft="21dp"
                android:layout_marginRight="21dp"
                android:layout_marginTop="32dp"
                android:layout_below="@id/layout_accout"
                android:orientation="horizontal">
                <TextView
                    style="@style/style_login_title_txt"
                    android:id="@+id/setting_perfusion_weight_title"
                    android:layout_width="103dp"
                    android:layout_height="match_parent"
                    android:textColor="@color/blue"
                    android:text="登录密码" />
                <!-- 密码 -->
                <EditText
                    style="@style/style_pre_setting_iconedit"
                    android:id="@+id/login_info_pwd_et"
                    android:layout_height="match_parent"
                    android:inputType="numberDecimal"
                    android:layout_marginLeft="2dp"
                    android:maxLength="10"
                    android:textColor="@color/blue"
                    android:background="@drawable/shape_rect_stoke"/>
            </LinearLayout>
        </RelativeLayout>
