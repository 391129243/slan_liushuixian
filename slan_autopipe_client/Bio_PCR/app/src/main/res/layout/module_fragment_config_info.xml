<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="#F5F5F5"
    android:padding="14dp">

    <RelativeLayout
        android:id="@+id/config_info_head_layout"
        android:layout_width="match_parent"
        android:layout_height="46dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_info_project_title"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"/>
        <TextView
            android:id="@+id/config_info_test_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:text="@string/config_info_test_project"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>


        <TextView
            android:id="@+id/config_info_delete_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/config_info_test_tv"
            android:layout_marginRight="12dp"
            android:text="@string/config_info_delete_project"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>
        <TextView
            android:id="@+id/config_info_edit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_edit_project"
            android:layout_toLeftOf="@id/config_info_delete_tv"
            android:layout_marginRight="12dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>

        <TextView
            android:id="@+id/config_info_create_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/config_info_create_project"
            android:layout_toLeftOf="@id/config_info_edit_tv"
            android:layout_marginRight="12dp"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>
    </RelativeLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/config_info_project_recycleview"
        android:layout_below="@id/config_info_head_layout"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/white" />


    <!--基本信息-->
    <LinearLayout
        android:id="@+id/config_info_project_info_layout"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:layout_below="@id/config_info_project_recycleview"
        android:orientation="vertical"
        android:background="@drawable/shape_rect_white_bg">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="2dp"
            android:text="@string/config_info_basic_info"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/blue"/>
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/config_info_project_name_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            custom:title_text="@string/config_info_project_name"
            custom:content_text=""
            custom:title_text_color="@color/blue"
            custom:content_text_color="@color/black" />

        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/config_info_project_type_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            custom:title_text="@string/config_info_project_type"
            custom:content_text=""
            custom:title_text_color="@color/blue"
            custom:content_text_color="@color/black"/>

        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/config_info_project_reaction_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            custom:title_text="@string/config_info_reaction"
            custom:content_text=""
            custom:title_text_color="@color/blue"
            custom:content_text_color="@color/black"/>

        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/config_info_project_unit_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            custom:title_text="@string/config_info_unit"
            custom:content_text=""
            custom:title_text_color="@color/blue"
            custom:content_text_color="@color/black"/>


        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/config_info_project_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            custom:title_text="@string/config_hex_time"
            custom:content_text=""
            custom:title_text_color="@color/blue"
            custom:content_text_color="@color/black"/>

        <TextView
            android:id="@+id/config_info_program_tab_tv"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="@string/config_info_experiment_program"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginTop="60dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>

        <TextView
            android:id="@+id/config_info_param_tab_tv"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:text="@string/config_info_parameters_info"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginTop="60dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="12dp"
        android:paddingLeft="8dp"
        android:layout_below="@id/config_info_project_recycleview"
        android:layout_toRightOf="@id/config_info_project_info_layout"
        android:visibility="visible">
        <HorizontalScrollView
            android:id="@+id/config_info_slan_step_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/config_info_slan_program_title_layout"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="48dp">
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/config_info_slan_program_recycle_layout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal"
                    >
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/config_info_slan_program_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/config_info_slan_program_title_layout"
                    android:layout_above="@id/config_info_slan_program_recycle_layout"/>
            </RelativeLayout>
        </HorizontalScrollView>

        <RelativeLayout
            android:id="@+id/config_info_param_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_rect_white_bg"
            android:padding="8dp"
            android:visibility="visible">

            <TextView
                android:id="@+id/config_type_target_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_info_experiment_parameters"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/config_info_basic_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_below="@id/config_type_target_title"
                android:orientation="vertical">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@color/color_recycle"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_channel"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="1"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="2"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="3"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="4"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="5"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="6"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_dye"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="FAM"
                        android:textStyle="bold"
                        android:textColor="@color/chart_blue"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="HEX"
                        android:textSize="@dimen/font_size_large_20sp"
                        android:textStyle="bold"
                        android:textColor="@color/chart_green"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="ROX"
                        android:textSize="@dimen/font_size_large_20sp"
                        android:textStyle="bold"
                        android:textColor="@color/chart_orange"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="CY5"
                        android:textSize="@dimen/font_size_large_20sp"
                        android:textStyle="bold"
                        android:textColor="@color/red"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="QUASAR 705"
                        android:textSize="@dimen/font_size_large_20sp"
                        android:textStyle="bold"
                        android:textColor="@color/quasar"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="ATTO 425"
                        android:textSize="@dimen/font_size_large_20sp"
                        android:textStyle="bold"
                        android:textColor="@color/atto"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
                <!--选择-->
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_check"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <CheckBox
                        android:id="@+id/config_info_fam_ck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:clickable="false"
                        android:layout_height="match_parent"
                        android:gravity="center" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <CheckBox
                        android:id="@+id/config_info_hex_ck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:gravity="center" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <CheckBox
                        android:id="@+id/config_info_rox_ck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:gravity="center"
                        />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <CheckBox
                        android:id="@+id/config_info_cy5_ck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:gravity="center" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <CheckBox
                        android:id="@+id/config_info_quasar_ck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:gravity="center" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <CheckBox
                        android:id="@+id/config_info_atto_ck"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:gravity="center" />
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <LinearLayout
                android:id="@+id/config_info_param_setting_title_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/config_info_basic_layout"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/config_info_param_setting_title_basic_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:textColor="@color/white"
                    android:text="@string/config_info_basic_parameters"
                    android:background="@drawable/shape_rect_blue"/>
                <TextView
                    android:id="@+id/config_info_param_setting_title_melt_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:gravity="center"
                    android:text="@string/config_info_melt_curve_parameters"
                    android:background="@drawable/shape_rect_blue_stroke"/>
            </LinearLayout>
            <!--扩增曲线算法参数-->
            <LinearLayout
                android:id="@+id/config_info_amp_param_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/config_info_param_setting_title_layout"
                android:visibility="gone"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/config_info_amp_param_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/config_info_amplification_curve_algorithm"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <TextView
                        android:id="@+id/config_info_amp_algorithm_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingLeft="12dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_normal_18sp" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@null"
                        android:src="@drawable/arrow_press" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:background="@color/color_recycle">
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_dye_1"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_channel"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_analyse_type"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_begin_baseline"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_end_baseline"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_optimization"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_auto_threshold"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_manual_threshold"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                    <TextView
                        style="@style/style_config_ex_pamram_tv"
                        android:layout_weight="1"
                        android:text="@string/config_info_digital_filter"
                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/blue"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
                <ListView
                    android:id="@+id/config_info_amp_algorithm_lv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dividerHeight="1dp"
                    android:divider="@color/blue"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/blue"/>
            </LinearLayout>

