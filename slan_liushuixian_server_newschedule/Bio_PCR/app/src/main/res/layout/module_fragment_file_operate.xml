<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:orientation="horizontal">
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:layout_height="match_parent"
            android:background="@color/white">
            <RelativeLayout
                android:id="@+id/export_file_local_file_top_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@color/blue">
                <TextView
                    android:id="@+id/export_file_local_file_title"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/result_export_loacal_files"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_size_large_20sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/file_operate_local_file_back_tv"
                android:layout_below="@id/export_file_local_file_top_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_alignParentRight="true"
                android:text="@string/setting_template_back"
                android:textColor="@color/color_blue_odd_selector"
                android:textSize="@dimen/font_size_large_20sp"/>
            <LinearLayout
                android:id="@+id/file_operate_local_bottom_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/file_operate_create_local_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableTop="@drawable/icon_create_enable"
                    android:gravity="center"
                    android:text="@string/result_export_create" />

                <TextView
                    android:id="@+id/file_operate_reflesh_local_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_refresh"
                    android:drawableTop="@drawable/icon_reflesh_no"/>

                <TextView
                    android:id="@+id/file_operate_copy_local_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_copy"
                    android:drawableTop="@drawable/icon_copy_file"/>


                <TextView
                    android:id="@+id/file_operate_delete_local_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_delete"
                    android:drawableTop="@drawable/icon_delete_no"/>

                <TextView
                    android:id="@+id/file_operate_allcheck_local_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_allcheck"
                    android:drawableTop="@drawable/icon_allcheck_no"/>
                <TextView
                    android:id="@+id/file_operate_cancel_local_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_cancel"
                    android:drawableTop="@drawable/icon_cancel_no"/>
            </LinearLayout>
            <View
                android:id="@+id/local_devider"
                android:layout_width="match_parent"
                android:layout_above="@id/file_operate_local_bottom_layout"
                android:layout_height="1px"
                android:background="@color/detect_gray"/>

            <ListView
                android:id="@+id/file_operate_local_file_lv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/white"
                android:dividerHeight="1dp"
                android:layout_above="@id/local_devider"
                android:layout_below="@id/file_operate_local_file_back_tv"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp" />

        </RelativeLayout>
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_margin="12dp"
            android:orientation="vertical"
            android:layout_height="match_parent"
            android:background="@color/white">
            <RelativeLayout
                android:id="@+id/file_operate_usb_file_top_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@color/blue">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:layout_alignParentLeft="true"
                    android:text="@string/result_export_usb_files"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_size_large_20sp"
                    android:background="@color/blue"/>

                <TextView
                    android:id="@+id/file_operate_usb_file_num_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:layout_alignParentRight="true"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_size_large_20sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/file_operate_ufile_back_tv"
                android:layout_below="@id/file_operate_usb_file_top_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_alignParentRight="true"
                android:text="@string/setting_template_back"
                android:textColor="@color/color_blue_odd_selector"
                android:textSize="@dimen/font_size_large_20sp"/>
            <LinearLayout
                android:id="@+id/export_file_usb_bottom_layout"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:gravity="center_vertical"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/file_operate_create_usb_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_create"
                    android:drawableTop="@drawable/icon_create_enable"/>
                <TextView
                    android:id="@+id/file_operate_copy_usb_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_copy"
                    android:drawableTop="@drawable/icon_copy_file"/>

                <TextView
                    android:id="@+id/file_operate_delete_usb_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/delete"
                    android:drawableTop="@drawable/icon_delete_no"/>
                <TextView
                    android:id="@+id/file_operate_rename_usb_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_rename"
                    android:drawableTop="@drawable/icon_rename_no"/>
                <TextView
                    android:id="@+id/file_operate_allcheck_usb_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_allcheck"
                    android:drawableTop="@drawable/icon_allcheck_no"/>
                <TextView
                    android:id="@+id/file_operate_cancel_usb_tv"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_export_cancel"
                    android:drawableTop="@drawable/icon_cancel_no"/>
            </LinearLayout>
            <View
                android:id="@+id/usb_devider"
                android:layout_width="match_parent"
                android:layout_above="@id/export_file_usb_bottom_layout"
                android:layout_height="1px"
                android:background="@color/detect_gray"/>
            <ListView
                android:id="@+id/file_operate_udisk_file_lv"
                android:layout_below="@id/file_operate_ufile_back_tv"
                android:layout_above="@id/usb_devider"
                android:divider="@color/white"
                android:dividerHeight="1dp"
                android:layout_margin="12dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>