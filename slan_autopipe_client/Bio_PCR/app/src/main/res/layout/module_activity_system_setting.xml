<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
    <include
        android:id="@+id/system_setting_title_layout"
        layout="@layout/include_common_title_layout"/>

    <LinearLayout
        android:id="@+id/system_setting_tab_layout"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/system_setting_title_layout"
        android:background="@color/color_main_text">
        <LinearLayout
            android:id="@+id/system_setting_tab_procedure_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_system"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_procedure_configuration"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_template_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_file_operation"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_file_manager"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            android:visibility="gone"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_pcr_config_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_device_info"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_pcr_config"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>

        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_rna_config_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_device_info"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_rna_config"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>


        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            android:visibility="gone"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_hardware_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_account_manager"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_user_manager"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            android:visibility="visible"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_login_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_modify_logninfo"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_change_login_info"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            android:visibility="gone"
            style="@style/horizontal_line"/>

        <LinearLayout
            android:id="@+id/system_setting_tab_filebrowser_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_file_manager"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_ES_file_info"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_systemreset_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_system_reset"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_change_systemreset"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_secret_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_general"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="系统维修"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:id="@+id/secret_divider_line"
            android:layout_height="2dp"
            android:background="@color/white"
            android:visibility="invisible"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/system_setting_tab_opendoor_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="visible"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_system_copy"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_opendoor"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/system_setting_tab_result_copy_rb"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="invisible"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_system_copy"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/setting_copy_result"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:id="@+id/copy_result_divider_line"
            android:layout_height="2dp"
            android:background="@color/white"
            android:visibility="invisible"
            style="@style/horizontal_line"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/system_setting_frame_layout"
        android:layout_below="@id/system_setting_title_layout"
        android:layout_toRightOf="@id/system_setting_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </FrameLayout>
</RelativeLayout>