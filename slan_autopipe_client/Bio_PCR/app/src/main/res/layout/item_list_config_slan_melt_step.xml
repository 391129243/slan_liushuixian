<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="326dp"
    android:paddingTop="12dp"
    android:layout_height="match_parent"
    android:id="@+id/item_pcr_melt_step_layout"
    android:background="@drawable/item_bg_selector">
    <TextView
        android:id="@+id/item_slan_melt_config_devider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:background="@color/color_btn_normal"/>
    <TextView
        android:id="@+id/item_slan_melt_step_name_tv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="invisible"
        android:layout_marginBottom="10dp"
        android:textColor="@color/color_main_text"
        android:textSize="18sp"/>
    <ImageView
        android:id="@+id/item_slan_melt_step_acquisition_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingRight="24dp"
        android:paddingLeft="24dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:src="@drawable/icon_acquisition_uncheck"
        android:contentDescription="@null"/>
    <ImageView
        android:id="@+id/item_slan_melt_step_temp_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingRight="24dp"
        android:paddingLeft="24dp"
        android:layout_toLeftOf="@id/item_slan_melt_step_acquisition_img"
        android:layout_alignParentBottom="true"
        android:src="@drawable/icon_step_temp"
        android:contentDescription="@null"/>
    <ImageView
        android:id="@+id/item_slan_melt_step_right_temp_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingRight="24dp"
        android:paddingLeft="24dp"
        android:layout_toRightOf="@id/item_slan_melt_step_acquisition_img"
        android:layout_alignParentBottom="true"
        android:src="@drawable/icon_step_temp"
        android:contentDescription="@null"/>

    <com.gzlab.autoassemblyline_client.view.MeltStepView
        android:id="@+id/item_slan_melt_step_view_tv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/item_slan_melt_step_name_tv"
        android:layout_above="@id/item_slan_melt_step_acquisition_img"/>

</RelativeLayout>