<?xml version="1.0" encoding="utf-8"?>
<!--输入系统密码-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:gravity="center"
            android:text="@string/system_password"
            android:textColor="@color/blue"
            android:textSize="22sp"/>

        <com.gzlab.autoassemblyline_client.view.SystemKeyBoardEditText
            android:id="@+id/dialog_correct_password_edit"
            android:layout_width="288dp"
            android:layout_height="60dp"
            android:textSize="28sp"
            android:textColor="@color/color_system_rb_bg_pressed"
            android:layout_marginLeft="32dp"
            android:maxLength="8"
            android:gravity="center"
            android:inputType="number"
            android:background="@drawable/shape_custom_detectionview_bg"
            custom:outSideCancel="true"
            custom:keyDrawable="@drawable/btn_keyboard_key"
            custom:xmlLayoutResId="@xml/keyboard_numbers"
            custom:isRandom="false"
            />


    </LinearLayout>
</RelativeLayout>