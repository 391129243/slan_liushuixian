                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="200dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:background="#80B4FE"
                        android:layout_margin="10dp">
                        <RelativeLayout
