<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:custom="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/result_title_layout"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@color/white">

        <TextView
            android:id="@+id/tab_title_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginLeft="12dp"
            android:layout_centerVertical="true"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_large_22sp"/>
        <!--显示时间-->
        <com.gidi.bio_pcr.view.DateTimeView
            android:id="@+id/result_time_ll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_marginRight="8dp"
            custom:title_text_color="@color/black"
            custom:content_text_color="@color/black">
        </com.gidi.bio_pcr.view.DateTimeView>
        <ImageView
            android:id="@+id/result_tab_back_img"
            android:layout_width="wrap_content"
            android:padding="14dp"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@id/result_time_ll"
            android:layout_marginRight="40dp"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_main"
            android:background="@drawable/shape_oval_top_bg"
            android:contentDescription="@null"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/result_tab_layout"
        android:layout_width="180dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/result_title_layout"
        android:background="@color/color_bioway_top_bar_bg">
        <LinearLayout
            android:id="@+id/result_experiment_tab"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_experiment"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/expriment_recond"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            style="@style/horizontal_line"/>
        <LinearLayout
            android:id="@+id/result_wellresult_tab"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/selector_info_tab_bg"
            android:padding="8dp">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_well"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:text="@string/wellresult_recond"
                android:textSize="@dimen/font_size_large_20sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <TextView
            android:layout_height="2dp"
            android:background="@color/white"
            style="@style/horizontal_line"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/result_frame_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/result_title_layout"
        android:layout_toRightOf="@id/result_tab_layout"
        android:background="#F5F5F5">

    </FrameLayout>

</RelativeLayout>