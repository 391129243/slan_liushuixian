<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="model"
            type="com.paul.pipeline.model.TemplateModel" />
        <variable
            name="recyclerViewItemClick"
            type="com.paul.pipeline.adapter.TemplateListAdapter.RecyclerViewItemClickMethod" />
    </data>
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/templatelist_item_rl"
    android:background="@drawable/selector_general_btn_bg"
    android:onClick="@{recyclerViewItemClick::trayViewClick}">
    <TextView
        android:id="@+id/name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:textColor="@color/color_file_name_selector"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="@{model.name}"/>
</RelativeLayout>
</layout>