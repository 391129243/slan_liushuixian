<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="data"
            type="com.paul.pipeline.model.SampleHoleModel" />
    </data>
    <RelativeLayout
        android:id="@+id/hole_rl"
        android:layout_width="@dimen/pipemain_hole_size"
        android:layout_height="@dimen/pipemain_hole_size"
        android:background="@drawable/shape_oval_blue_bg"
        android:layout_marginLeft="@dimen/pipemain_hole_left">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/content_text"
            android:textSize="@dimen/pipemain_hole_text"
            android:layout_centerInParent="true"
            app:intToString="@{data.index}" />
    </RelativeLayout>
</layout>