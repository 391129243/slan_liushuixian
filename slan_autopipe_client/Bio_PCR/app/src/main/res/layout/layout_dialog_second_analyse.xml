<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    xmlns:custom="http://schemas.android.com/apk/res-auto">

    <RadioGroup
        android:id="@+id/dialog_second_analyse_rg"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/dlg_result_auto_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:text="自动阈值"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:textSize="@dimen/font_size_normal_18sp"
            android:button="@null"
            android:drawableRight="@drawable/item_checkbox_selector"
            android:paddingRight="24dp"/>

        <RadioButton
            android:id="@+id/dlg_result_manual_tv"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:paddingLeft="24dp"
            android:text="手动阈值"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:textSize="@dimen/font_size_normal_18sp"
            android:button="@null"
            android:drawableRight="@drawable/item_checkbox_selector"/>

    </RadioGroup>

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingBottom="100dp"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_main_text"
            android:text="FAM:"/>
        <com.gzlab.autoassemblyline_client.view.SystemKeyBoardEditText
            android:id="@+id/result_fam_controrn_tv"
            android:layout_width="78dp"
            android:layout_marginLeft="4dp"
            android:layout_height="38dp"
            android:inputType="number"
            android:maxLength="4"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textColorHint="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:background="@drawable/shape_rect_stoke"
            custom:outSideCancel="true"
            custom:keyDrawable="@drawable/btn_keyboard_key"
            custom:xmlLayoutResId="@xml/keyboard_numbers"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_main_text"
            android:text="HEX:"/>
        <com.gzlab.autoassemblyline_client.view.SystemKeyBoardEditText
            android:id="@+id/result_hex_controrn_tv"
            android:layout_width="78dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:inputType="number"
            android:maxLength="4"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textColorHint="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:background="@drawable/shape_rect_stoke"
            custom:outSideCancel="true"
            custom:keyDrawable="@drawable/btn_keyboard_key"
            custom:xmlLayoutResId="@xml/keyboard_numbers"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_main_text"
            android:text="ROX:"/>
        <com.gzlab.autoassemblyline_client.view.SystemKeyBoardEditText
            android:id="@+id/result_rox_controrn_tv"
            android:layout_width="78dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:inputType="number"
            android:maxLength="4"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textColorHint="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:background="@drawable/shape_rect_stoke"
            custom:outSideCancel="true"
            custom:keyDrawable="@drawable/btn_keyboard_key"
            custom:xmlLayoutResId="@xml/keyboard_numbers"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_main_text"
            android:text="CY5:"/>
        <com.gzlab.autoassemblyline_client.view.SystemKeyBoardEditText
            android:id="@+id/result_cy5_controrn_tv"
            android:layout_width="78dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:maxLength="4"
            android:inputType="number"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textColorHint="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:background="@drawable/shape_rect_stoke"
            custom:outSideCancel="true"
            custom:keyDrawable="@drawable/btn_keyboard_key"
            custom:xmlLayoutResId="@xml/keyboard_numbers"/>
    </LinearLayout>
</LinearLayout>