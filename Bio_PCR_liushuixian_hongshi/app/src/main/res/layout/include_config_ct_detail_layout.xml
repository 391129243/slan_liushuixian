<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:background="@color/white">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/single_create_judge_ct_list_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/blue"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_all_check"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_serial_number"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_channel"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_category"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_ctvalue"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_lower_limit"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_upper_limit"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
            <TextView
                style="@style/style_config_ex_pamram_tv"
                android:layout_weight="1"
                android:text="@string/create_multi_suspicious_interval"
                android:textColor="@color/black"/>
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/blue"/>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/blue"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <ListView
        android:id="@+id/config_create_judge_ct_detail_lv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@color/blue"
        android:dividerHeight="1dp"
        android:layout_below="@id/single_create_judge_ct_list_title"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/config_create_judge_ct_detail_lv"
        android:background="@color/blue"/>

</RelativeLayout>