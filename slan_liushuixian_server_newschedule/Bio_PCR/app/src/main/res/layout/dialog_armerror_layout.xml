<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"  
	android:layout_height="match_parent" >
	<RelativeLayout
		android:layout_width="600dp"
	    android:layout_height="400dp"
	    android:layout_centerInParent="true"
		android:layout_gravity="center"
		android:background="@drawable/shape_rect_white_bg"
	    android:orientation="vertical">

		<TextView
			android:id="@+id/title"  
	        android:layout_width="match_parent"
	        android:layout_height="50dp"
	        android:gravity="center"  
	        android:text="@string/dialog_title_prompt"
			android:textColor="@color/white"
			android:background="@drawable/dialog_title_bg"
	        android:textSize="@dimen/font_size_large_22sp" />


		<LinearLayout
			android:id="@+id/dialog_btn_layout"
			android:layout_width="fill_parent"
			android:layout_height="50dp"
			android:layout_alignParentBottom="true"
			android:layout_gravity="bottom"
			android:orientation="horizontal" >
			<TextView
				android:id="@+id/negative_btn"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:text="@string/dialog_cancel"
				android:textSize="@dimen/font_size_large_20sp"
				android:textColor="@color/black"
				android:background="@drawable/dialog_cancel_btn_bg"
				android:gravity="center" />

			<TextView
				style="@style/style_portrait_line"
				android:background="@color/check_normal_bg"/>

			<TextView
				android:id="@+id/reset_btn"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="match_parent"
				android:background="@drawable/dialog_ok_btn_bg"
				android:gravity="center"
				android:text="@string/main_reset_exception"
				android:textColor="@color/red"
				android:textSize="@dimen/font_size_large_20sp" />

			<TextView
				style="@style/style_portrait_line"
				android:background="@color/check_normal_bg"/>

			<TextView
				android:id="@+id/continue_btn"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="match_parent"
				android:background="@drawable/dialog_ok_btn_bg"
				android:gravity="center"
				android:text="@string/main_continue_exception"
				android:textColor="@color/color_system_rb_bg_pressed"
				android:textSize="@dimen/font_size_large_20sp" />

			<TextView
				android:id="@+id/skip_line"
				style="@style/style_portrait_line"
				android:background="@color/check_normal_bg"
				android:visibility="gone"/>

			<TextView
				android:id="@+id/skip_btn"
				android:layout_width="0dp"
				android:layout_weight="1"
				android:layout_height="match_parent"
				android:background="@drawable/dialog_ok_btn_bg"
				android:gravity="center"
				android:text="@string/main_skip_tray_exception"
				android:textColor="@color/red"
				android:textSize="@dimen/font_size_large_20sp"
				android:visibility="gone" />
		</LinearLayout>
		<TextView
			style="@style/horizontal_line"
			android:background="@color/check_normal_bg"
			android:layout_above="@id/dialog_btn_layout"/>
	   <LinearLayout  
			android:id="@+id/content"
		    android:layout_below="@id/title"
		   	android:layout_above="@id/dialog_btn_layout"
		    android:layout_width="match_parent"
		    android:layout_height="match_parent"
		    android:padding="10dp"
		    android:gravity="center" >
			<TextView  
				android:id="@+id/message"   
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"  
				android:gravity="center"
	            android:textSize="20sp" />  
		</LinearLayout>  

	</RelativeLayout>
</RelativeLayout>

