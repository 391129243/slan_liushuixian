<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/item_ct_judge_rootlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/single_create_ck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/item_checked"
                android:gravity="center" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <!--序号-->
        <TextView
            style="@style/style_config_ex_pamram_tv"
            android:id="@+id/item_single_create_index_tv"
            android:layout_weight="1"
            android:text="1"
            android:textStyle="bold"
            android:textColor="@color/chart_blue"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <!--通道-->
        <TextView
            style="@style/style_config_ex_pamram_tv"
            android:id="@+id/item_single_create_channel_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="FAM"
            android:textSize="@dimen/font_size_large_20sp"
            android:textColor="@color/deep_gray"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>

        <!--种类-->
        <TextView
            android:id="@+id/item_single_create_type_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:text="甲流" />
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>

        <!--ct值-->
        <TextView
            android:id="@+id/item_single_create_ct_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp" />
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <!--下限值-->
        <TextView
            android:id="@+id/config_judge_single_fam_lower_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:text="20" />
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <!--上限值-->
        <TextView
            android:id="@+id/config_judge_single_ct_upper_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:text="3" />
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <!--可疑-->
        <TextView
            android:id="@+id/config_judge_single_ct_suspicious_tv"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/blue"
            android:textSize="@dimen/font_size_normal_18sp"
            android:text="3" />
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>