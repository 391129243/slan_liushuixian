<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="horizontal"
    xmlns:custom="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/heartbeat"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="握手"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
            <Button
                android:id="@+id/get_pcr_tempreture"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="获取PCR温度"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/led_on"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="指示灯亮"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
            <Button
                android:id="@+id/led_blight"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:text="指示灯闪"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/pcr_tempreture"
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/shape_rect_stoke"
                android:inputType="number"
                android:singleLine="true"
                android:gravity="center"
                android:text="35"
                android:textColor="@color/black"
                android:textSize="20sp" />
            <Button
                android:id="@+id/set_pcr_tempreture"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginLeft="30dp"
                android:text="设置PCR温度"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/motor_reset"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginLeft="00dp"
                android:text="电机复位"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
            <Button
                android:id="@+id/motor_scan"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:layout_marginLeft="10dp"
                android:text="电机扫描"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/get_fluro"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="获取荧光"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>

            <Button
                android:id="@+id/printter"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="打印测试"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/wss_server"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="启动wssserver"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="500dp"
            android:gravity="top"
            android:orientation="horizontal">
            <ScrollView
                android:id="@+id/recevie_data"
                android:layout_width="match_parent"
                android:layout_height="500dp">
                <TextView
                    android:id="@+id/log"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="12dp"
                    android:textColor="@color/black"
                    android:text="1213"
                    android:textSize="10sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tempreture1"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_marginLeft="12dp"
                android:textColor="@color/black"
                android:text="1213"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/tempreture2"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_marginLeft="12dp"
                android:textColor="@color/black"
                android:text="1213"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/tempreture3"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:layout_marginLeft="12dp"
                android:textColor="@color/black"
                android:text="1213"
                android:textSize="20sp" />


        </LinearLayout>
        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="300dp"
            android:orientation="vertical">
            <ListView
                android:id="@+id/listview_flu"
                android:layout_width="400dp"
                android:layout_height="300dp"
                android:dividerHeight="1dp"
                android:layout_marginLeft="5dp"
                android:divider="@color/blue"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/config_pcr"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="配置PCR"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/config_info_project_recycleview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/white" />
        <LinearLayout
            android:layout_width="400dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/load_pcr"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="载入结果"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/config_info_experiment_recycleview"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="580dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="580dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/create_hex"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="生成hex"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
            <Button
                android:id="@+id/run_hex"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="运行"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
            <Button
                android:id="@+id/stop_hex"
                android:layout_width="140dp"
                android:layout_height="40dp"
                android:text="停止"
                android:textSize="20sp"
                android:textColor="@color/blue"
                android:background="@drawable/shape_btn_login"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="580dp"
            android:layout_height="50dp"
            android:gravity="left"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="当前程序段"
                android:textSize="10sp" />
            <EditText
                android:id="@+id/current_segment"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="当前循环"
                android:textSize="10sp" />
            <EditText
                android:id="@+id/current_cycle"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="当前步骤"
                android:textSize="10sp" />
            <EditText
                android:id="@+id/current_step"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp" />
            <EditText
                android:id="@+id/current_step_remaintime"
                android:layout_width="120sp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="运行时间"
                android:textSize="10sp" />
            <Chronometer
                android:id="@+id/chronometer"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="10sp" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="580dp"
            android:layout_height="50dp"
            android:gravity="left"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/current_action"
                android:layout_width="580dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="580dp"
            android:layout_height="150dp"
            android:orientation="vertical">
            <ListView
                android:id="@+id/listview_hex"
                android:layout_width="580dp"
                android:layout_height="150dp"
                android:dividerHeight="1dp"
                android:layout_marginLeft="5dp"
                android:divider="@color/blue"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/result_layout"
            android:layout_width="580dp"
            android:layout_height="450dp">
            <LinearLayout
                android:id="@+id/bowei_running_slan_chanel_layout"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.gidi.bio_pcr.view.CustomCheckText
                    android:id="@+id/bowei_result_slan_all_channel_check_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    custom:content_img="@drawable/item_chanel_uncheck"
                    custom:background_img="@drawable/shape_channel_all_channel_bg"
                    custom:content_text="All"/>

                <com.gidi.bio_pcr.view.CustomCheckText
                    android:id="@+id/bowei_running_slan_result_fam_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    custom:content_img="@drawable/item_chanel_uncheck"
                    custom:background_img="@drawable/shape_channel_fam_bg"
                    custom:content_text="FAM"/>

                <com.gidi.bio_pcr.view.CustomCheckText
                    android:id="@+id/bowei_running_slan_result_hex_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    custom:content_img="@drawable/item_chanel_uncheck"
                    custom:background_img="@drawable/shape_channel_hex_bg"
                    custom:content_text="HEX"/>


                <com.gidi.bio_pcr.view.CustomCheckText
                    android:id="@+id/bowei_running_slan_result_rox_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    custom:content_img="@drawable/item_chanel_uncheck"
                    custom:background_img="@drawable/shape_channel_rox_bg"
                    custom:content_text="ROX"/>

                <com.gidi.bio_pcr.view.CustomCheckText
                    android:id="@+id/bowei_running_slan_result_cy5_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    custom:content_img="@drawable/item_chanel_uncheck"
                    custom:background_img="@drawable/shape_channel_cy5_bg"
                    custom:content_text="CY5"/>

                <TextView
                    android:id="@+id/bowei_open_file_tv"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="打开文件"
                    android:textColor="@color/white"
                    android:background="@drawable/shape_channel_all_channel_bg"/>

                <TextView
                    android:id="@+id/bowei_running_slan_sec_analyse_tv"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"
                    android:text="@string/second_analyse"
                    android:textColor="@color/white"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:visibility="visible"
                    android:background="@drawable/selector_rect_blue_recycle"/>
            </LinearLayout>
            <RadioGroup
                android:id="@+id/bowei_result_slan_curve_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@id/bowei_running_slan_chanel_layout"
                android:layout_marginTop="8dp"
                android:layout_marginLeft="12dp"
                android:orientation="horizontal">
                <RadioButton
                    style="@style/style_tab_system_info_test"
                    android:id="@+id/bowei_result_slan_rawcurve_rb"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Raw"
                    />
                <RadioButton
                    style="@style/style_tab_system_info_test"
                    android:id="@+id/bowei_result_slan_ampcurve_rb"
                    android:layout_marginLeft="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="AMP"
                    />
                <RadioButton
                    style="@style/style_tab_system_info_test"
                    android:id="@+id/bowei_result_slan_meltcurve_rb"
                    android:layout_marginLeft="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Melt"
                    />
                <RadioButton
                    style="@style/style_tab_system_info_test"
                    android:id="@+id/bowei_result_slan_peakcurve_rb"
                    android:layout_marginLeft="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Melt Peak"
                    />
                <RadioButton
                    style="@style/style_tab_system_info_test"
                    android:id="@+id/bowei_result_slan_list_rb"
                    android:layout_marginLeft="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/running_curve_excel"
                    />
                <RadioButton
                    style="@style/style_tab_system_info_test"
                    android:id="@+id/bowei_result_slan_set_paramter_rb"
                    android:layout_marginLeft="4dp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/running_curve_set_paramter"
                    />
            </RadioGroup>
            <!--显示曲线-->
            <LinearLayout
                android:id="@+id/bowei_result_slan_hole_layout"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:paddingRight="36dp"
                android:layout_alignParentBottom="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_toRightOf="@id/bowei_running_slan_chanel_layout">
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_running_all_hole_ck"
                    android:textSize="@dimen/font_size_small_14sp"
                    android:text="@string/result_all_hole_check" />

                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_one_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A1" />
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_two_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A2" />
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_three_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A3" />
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_four_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A4" />
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_five_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A5" />
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_six_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A6" />
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_seven_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A7" />
                <TextView
                    style="@style/style_detect_hole"
                    android:id="@+id/bowei_result_slan_hole_eight_btn"
                    android:layout_marginLeft="12dp"
                    android:text="A8" />
            </LinearLayout>
            <!--显示曲线-->
            <LinearLayout
                android:id="@+id/bowei_result_slan_curve_chart_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_below="@id/bowei_result_slan_curve_layout"

                android:layout_toRightOf="@id/bowei_running_slan_chanel_layout"
                android:layout_above="@id/bowei_result_slan_hole_layout"
                android:visibility="visible">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/bowei_running_result_slan_curve_chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:layout_marginTop="10dp"
                    android:background="#f3f5f8"/>
            </LinearLayout>
            <!--显示参数-->

            <HorizontalScrollView
                android:id="@+id/bowei_result_slan_excel_list_scrollview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_below="@id/bowei_result_slan_curve_layout"
                android:layout_toRightOf="@id/bowei_running_slan_chanel_layout"
                android:layout_above="@id/bowei_result_slan_hole_layout"
                android:padding="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/bowei_result_slan_excel_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <!---标题-->
                    <include
                        android:id="@+id/bowei_resut_slan_list_title_layout"
                        layout="@layout/include_result_slan_excel_title_layout"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp" />
                    <ListView
                        android:id="@+id/bowei_result_slan_list_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:dividerHeight="1dp"
                        android:divider="@color/detect_gray"/>
                </LinearLayout>
            </HorizontalScrollView>
            <!--二次分析的页面-->
            <RelativeLayout
                android:id="@+id/bowei_slan_result_sec_analyse_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:padding="4dp"
                android:layout_below="@id/bowei_result_slan_curve_layout"
                android:layout_toRightOf="@id/bowei_running_slan_chanel_layout"
                android:layout_above="@id/bowei_result_slan_hole_layout">
                <!--基本参数，熔解曲线参数标题-->
                <LinearLayout
                    android:id="@+id/bowei_slan_result_sec_analyse_param_title_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/bowei_slan_result_basic_param_title_tv"
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:textSize="@dimen/font_size_normal_18sp"
                        android:textColor="@color/white"
                        android:text="基本参数"
                        android:background="@drawable/shape_rect_blue"/>
                    <TextView
                        android:id="@+id/bowei_slan_result_melt_param_title_tv"
                        android:layout_width="120dp"
                        android:layout_height="32dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/font_size_normal_18sp"
                        android:gravity="center"
                        android:text="熔解曲线参数"
                        android:background="@drawable/shape_rect_blue_stroke"/>
                </LinearLayout>
                <!--扩增曲线算法参数-->
                <LinearLayout
                    android:id="@+id/bowei_slan_result_sec_analyse_amp_param_layout"
                    android:layout_width="match_parent"
                    android:layout_height="310dp"
                    android:visibility="visible"
                    android:layout_below="@id/bowei_slan_result_sec_analyse_param_title_layout"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="扩增曲线算法"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/font_size_normal_18sp" />

                        <TextView
                            android:id="@+id/bowei_slan_result_sec_analyse_amp_algorithm_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingLeft="12dp"
                            android:text="相对荧光值法-log"
                            android:textColor="@color/black"
