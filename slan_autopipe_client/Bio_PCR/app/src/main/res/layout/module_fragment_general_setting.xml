<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:id="@+id/general_setting_item_layout"
        android:layout_width="200dp"
        android:layout_height="400dp"
        android:layout_marginLeft="120dp"
        android:padding="20dp"
        android:background="@drawable/shape_rect_white_bg"
        android:orientation="vertical">
        <TextView
            android:id="@+id/general_set_language_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/general_language_setting"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/shape_general_pressed_btn"/>
        <TextView
            android:id="@+id/general_set_volume_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/general_volume_setting"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/shape_general_normal_btn"/>

        <TextView
            android:id="@+id/general_set_time_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/general_time_setting"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/shape_general_normal_btn"/>

        <TextView
            android:id="@+id/general_set_upload_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/general_upload_setting"
            android:padding="8dp"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/shape_general_normal_btn"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/general_setting_languege_layout"
        android:layout_toRightOf="@id/general_setting_item_layout"
        android:layout_width="600dp"
        android:layout_height="400dp"
        android:layout_marginLeft="120dp"
        android:visibility="visible"
        android:gravity="center_vertical"
        android:background="@drawable/shape_rect_white_bg"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/general_language_chinese_layout"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginLeft="120dp"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/color_main_text">
            <ImageView
                android:id="@+id/english_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:src="@drawable/chinese"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system_language_chinese"
                android:textSize="@dimen/font_size_normal_16sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/general_language_english_layout"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginLeft="120dp"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/color_main_text">
            <ImageView
                android:id="@+id/chinese_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:src="@drawable/english"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/system_language_english"
                android:textSize="@dimen/font_size_normal_16sp"
                android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/general_setting_volume_layout"
        android:layout_toRightOf="@id/general_setting_item_layout"
        android:layout_width="600dp"
        android:layout_height="400dp"
        android:layout_marginLeft="120dp"
        android:gravity="center_vertical"
        android:background="@drawable/shape_rect_white_bg"
        android:orientation="horizontal"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/general_volume_sound_layout"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="120dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/color_main_text">
            <ImageView
                android:id="@+id/sound_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_set_sound"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volume_alarm"
                android:textSize="@dimen/font_size_normal_16sp"
                android:textColor="@color/white"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/general_volume_mute_layout"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginLeft="120dp"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/color_main_text">
            <ImageView
                android:id="@+id/mute_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:src="@drawable/icon_set_mute"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volume_mute"
                android:textSize="@dimen/font_size_normal_16sp"
                android:textColor="@color/white"/>
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:id="@+id/general_setting_time_layout"
        android:layout_toRightOf="@id/general_setting_item_layout"
        android:layout_width="600dp"
        android:layout_height="400dp"
        android:layout_marginLeft="120dp"
        android:gravity="center_vertical"
        android:background="@drawable/shape_rect_white_bg"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/system_setting_date_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="10dp"
            android:textSize="@dimen/font_size_large_22sp"
            android:text="2020-07-21"
            android:layout_marginLeft="48dp"
            android:textColor="@color/color_blue_odd_selector"/>
        <TextView
            android:id="@+id/system_setting_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="36dp"
            android:gravity="center"
            android:padding="10dp"
            android:textSize="@dimen/font_size_large_22sp"
            android:text="09:20"
            android:textColor="@color/color_blue_odd_selector"/>
    </LinearLayout>

    <!--上传设置-->
    <LinearLayout
        android:id="@+id/general_setting_upload_layout"
        android:layout_toRightOf="@id/general_setting_item_layout"
        android:layout_width="600dp"
        android:layout_height="400dp"
        android:layout_marginLeft="120dp"
        android:background="@drawable/shape_rect_white_bg"
        android:orientation="vertical"
        android:visibility="visible">

        <!--上传的模式选择-->
        <RadioGroup
            android:id="@+id/general_setting_upload_rg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="88dp"
            android:orientation="horizontal">
            <RadioButton
                style="@style/style_tab_upload_mode_rb"
                android:id="@+id/general_setting_upload_http_rb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="HTTP网口" />
            <RadioButton
                style="@style/style_tab_upload_mode_rb"
                android:id="@+id/general_setting_upload_hl7_ethernet_rb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="HL7以太网口" />
            <RadioButton
                style="@style/style_tab_upload_mode_rb"
                android:id="@+id/general_setting_upload_hl7_serial_rb"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="HL7串口" />
        </RadioGroup>
        <!--HTTP以太网网络-->
        <LinearLayout
            android:id="@+id/general_upload_http_port_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:visibility="visible">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:gravity="center"
                android:padding="10dp"
                android:textSize="@dimen/font_size_large_22sp"
                android:text="@string/system_info_address"
                android:textColor="@color/color_blue_odd_selector"/>

            <EditText
                android:id="@+id/general_set_url_et"
                android:layout_width="240dp"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:textSize="@dimen/font_size_large_22sp"
                android:textColor="@color/color_blue_odd_selector"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:gravity="center"
                android:padding="10dp"
                android:textSize="@dimen/font_size_large_22sp"
                android:text="@string/general_port"
                android:textColor="@color/color_blue_odd_selector"/>
            <EditText
                android:id="@+id/general_set_port_et"
                android:layout_width="108dp"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:maxLength="4"
                android:gravity="center"
                android:inputType="number"
                android:textSize="@dimen/font_size_large_22sp"
                android:textColor="@color/color_blue_odd_selector"/>
        </LinearLayout>
        <!--HL7以太网-->
        <LinearLayout
            android:id="@+id/general_upload_hl7_ethernet_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:visibility="gone">
            <!--IP-->
            <!--端口-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:gravity="center"
                android:padding="10dp"
                android:textSize="@dimen/font_size_large_22sp"
                android:text="IP"
                android:textColor="@color/color_blue_odd_selector"/>

            <EditText
                android:id="@+id/general_set_hl7_ip_et"
                android:layout_width="240dp"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:textSize="@dimen/font_size_large_22sp"
                android:text="192.168.0.254"
                android:digits="01234567890."
                android:textColor="@color/color_blue_odd_selector"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:gravity="center"
                android:padding="10dp"
                android:textSize="@dimen/font_size_large_22sp"
                android:text="@string/general_port"
                android:textColor="@color/color_blue_odd_selector"/>
            <EditText
                android:id="@+id/general_set_hl7_port_et"
                android:layout_width="108dp"
                android:layout_height="42dp"
                android:layout_marginLeft="6dp"
                android:maxLength="5"
                android:gravity="center"
                android:inputType="number"
                android:text="63395"
                android:textSize="@dimen/font_size_large_22sp"
                android:textColor="@color/color_blue_odd_selector"/>
        </LinearLayout>
        <!--HL7串口-->
        <LinearLayout
            android:id="@+id/general_upload_hl7_serial_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

        </LinearLayout>
    </LinearLayout>
</RelativeLayout>