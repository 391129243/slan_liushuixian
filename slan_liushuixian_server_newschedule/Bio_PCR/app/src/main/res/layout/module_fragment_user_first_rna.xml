<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp"
    android:layout_marginBottom="42dp"
    android:background="@drawable/user_main_sub_bg">



    <RelativeLayout
        android:id="@+id/user_running_first_counter_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="@drawable/first_rna_countdown_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Chronometer
            android:id="@+id/user_first_rna_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:textColor="@color/white"
            android:textSize="48sp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/user_running_first_counter_title_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_centerHorizontal="true"
        android:layout_above="@id/user_running_first_counter_layout"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/user_first_rna_counter_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon_remaining_time"
            android:contentDescription="@null"/>
        <TextView
            android:id="@+id/user_first_rna_counter_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/running_fragment_remaining_time"
            android:layout_marginLeft="36dp"
            android:textColor="@color/color_user_main_text"
            android:textSize="32sp" />
    </LinearLayout>
</RelativeLayout>

