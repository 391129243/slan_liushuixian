<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_1_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="1"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_2_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="2"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_3_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="3"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_4_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="4"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_5_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="5"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_6_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="6"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_7_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="7"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_8_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="8"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_9_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="9"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_point_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="·"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_0_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_delete_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="删除"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">
        <View
            android:id="@+id/num_done_left"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/num_keyboard_minus_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="-"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>

        <TextView
            android:id="@+id/num_keyboard_done_tv"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="match_parent"
            android:text="完成"
            android:textSize="@dimen/font_size_normal_18sp"
            android:gravity="center"
            android:textColor="@color/black"
            android:background="@drawable/selector_numkeyboard_bg"/>
        <View
            android:id="@+id/num_done_right"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/blue"/>
</androidx.appcompat.widget.LinearLayoutCompat>