<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/copy_result_title_layout"
        layout="@layout/include_common_title_layout"/>
    <LinearLayout
        android:id="@+id/copy_result_file_layout"
        android:layout_width="420dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_below="@id/copy_result_title_layout"
        android:background="#F5F5F5">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/blue"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/white"
            android:text="@string/copy_result_file_list"/>

        <ListView
            android:id="@+id/copy_result_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="12dp"
            android:divider="@color/blue"
            android:dividerHeight="1dp" />
    </LinearLayout>
    <View
        android:id="@+id/copy_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/copy_result_file_layout"
        android:layout_below="@id/copy_result_title_layout"
        android:background="@color/blue"></View>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/copy_divider"
        android:layout_below="@id/copy_result_title_layout"
        android:background="@color/white">
        <TextView
            android:id="@+id/copy_tv"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_marginRight="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/copy_result"
            android:padding="8dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>

        <LinearLayout
            android:id="@+id/copy_result_insert_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/copy_tv"
            android:layout_margin="8dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:text="@string/copy_result_num"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_large_22sp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_weight="4"
                android:text="@string/copy_result_start_time"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_large_22sp" />

            <TextView
                android:id="@+id/copy_result_title_insert_endtime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:layout_weight="4"
                android:text="@string/copy_result_end_time"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_large_22sp" />

            <TextView
                android:id="@+id/copy_result_title_insert_check"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_margin="8dp"
                android:layout_weight="2"
                android:text="@string/copy_result_selected_or_not"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_large_20sp" />
        </LinearLayout>

        <View
            android:id="@+id/devider_1"
            style="@style/horizontal_line"
            android:layout_below="@id/copy_result_insert_title_layout"/>

        <LinearLayout
