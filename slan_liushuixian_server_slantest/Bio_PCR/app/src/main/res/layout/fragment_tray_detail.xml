<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.paul.pipeline.fragment.TrayDetailFragment">
    <data>
        <variable
            name="trayModel"
            type="com.paul.pipeline.fragment.model.PipeTrayModel" />
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.TrayDetailViewModel" />
    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/untouchview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:background="#50000000">

        </View>
        <LinearLayout
            android:id="@+id/mainbg_ll"
            android:layout_width="1280dp"
            android:layout_height="820dp"
            app:stringStatusImg="@{trayModel.status}"
            android:layout_centerInParent="true"
            android:padding="10dp"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                >
                <TextView
                    android:id="@+id/tv_trayname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_title"
                    android:textSize="@dimen/pipe_fragment_title"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:text="@{trayModel.name}" />


                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="20dp"
                    android:padding="10dp"
                    android:background="@drawable/icon_back_1"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/common_main_content_bg">
                <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:layout_alignParentLeft="true"
                    android:layout_marginLeft="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/pipemain_hole_text"
                    android:layout_gravity="center_vertical"
                    android:text="@string/pipe_main_tray_holename"
                     />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="@dimen/pipemain_hole_text"
                    android:layout_gravity="center_vertical"
                    app:intToString="@{viewModel.selectholeindex}" />

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="@dimen/pipemain_hole_text"
                    android:layout_marginLeft="40dp"
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:text="@string/result_reagent" />

                <com.gidi.bio_pcr.view.SystemKeyBoardEditText
                    android:id="@+id/regent_et"
                    android:layout_width="200dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="5dp"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/color_system_rb_bg_pressed"
                    android:maxLength="19"
                    android:gravity="center"
                    android:inputType="text"
                    android:digits="1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                    android:background="@drawable/shape_rect_stoke"
                    app:outSideCancel="true"
                    app:keyDrawable="@drawable/btn_keyboard_key"
                    app:xmlLayoutResId="@xml/keyboard_numbers"
                    app:isRandom="false"
                    android:text="@{viewModel.selectedHole.reagentCode}" />
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:id="@+id/reagentCode_clear_img"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/clear"
                    android:contentDescription="@null"/>
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:textSize="@dimen/pipemain_hole_text"
                    android:textColor="@color/white"
                    android:layout_marginLeft="30dp"
                    android:text="@string/result_idcard" />

                <com.gidi.bio_pcr.view.SystemKeyBoardEditText
                    android:id="@+id/idcard_et"
                    android:layout_width="200dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="5dp"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/color_system_rb_bg_pressed"
                    android:maxLength="20"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/shape_rect_stoke"
                    app:outSideCancel="true"
                    app:keyDrawable="@drawable/btn_keyboard_key"
                    app:xmlLayoutResId="@xml/keyboard_numbers"
                    app:isRandom="false"
                    android:text="@{viewModel.selectedHole.serialNum}"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:id="@+id/serialNum_clear_img"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/clear"
                    android:contentDescription="@null"/>
                    <Button
                        android:id="@+id/input_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="80dp"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="@string/confirm"
                        android:textSize="22sp"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
<!--                    <Button-->
<!--                        android:id="@+id/saveallcode_btn"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="40dp"-->
<!--                        android:layout_marginLeft="20dp"-->
<!--                        android:layout_gravity="center_vertical"-->
<!--                        android:background="@drawable/selector_general_btn_bg"-->
<!--                        android:paddingLeft="15dp"-->
<!--                        android:paddingRight="15dp"-->
<!--                        android:text="@string/save_all"-->
<!--                        android:textColor="@color/white"-->
<!--                        android:textSize="22sp" />-->

                    <Button
                        android:id="@+id/clearallcode_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginLeft="20dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/selector_general_btn_bg"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="@string/pipe_main_clear_all"
                        android:textColor="@color/white"
                        android:textSize="22sp" />
            </LinearLayout>

            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/samplehole_rv"
                android:layout_width="match_parent"
                android:layout_height="220dp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/common_main_content_bg">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/pipemain_hole_text"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="10dp"
                    android:text="@{viewModel.selecttitle}" />
<!--                <RadioGroup-->
<!--                    android:id="@+id/radioGroup"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="30dp"-->
<!--                    android:paddingLeft="5dp"-->
<!--                    android:paddingRight="5dp"-->
<!--                    android:layout_centerVertical="true"-->
<!--                    android:layout_alignParentLeft="true"-->
<!--                    android:layout_marginLeft="10dp"-->
<!--                    android:orientation="horizontal"-->
<!--                    android:dividerPadding="5dp">-->
<!--                    <RadioButton-->
<!--                        style="@style/style_tab_system_info"-->
<!--                        android:layout_width="100dp"-->
<!--                        android:layout_height="30dp"-->
<!--                        android:id="@+id/radioButton_choose_proj"-->
<!--                        android:text="@string/pipe_main_proj_choose"-->
<!--                        android:checked="@{viewModel.radioGroupOption==0}"/>-->
<!--                    <RadioButton-->
<!--                        style="@style/style_tab_system_info"-->
<!--                        android:layout_width="100dp"-->
<!--                        android:layout_height="30dp"-->
<!--                        android:id="@+id/radioButton_show_proj"-->
<!--                        android:text="@string/pipe_main_proj_confirm"-->
<!--                        android:checked="@{viewModel.radioGroupOption==1}"-->
<!--                        />-->

<!--                </RadioGroup>-->
                <Button
                    android:id="@+id/select_proj_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="20dp"
                    android:paddingLeft="15dp"
                    android:paddingRight="15dp"
                    android:text="@string/pipe_main_proj_choose"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:background="@drawable/selector_general_btn_bg"/>

            </RelativeLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/bottom_rl"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true">

                    <LinearLayout
                        android:id="@+id/urgent_ll"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="20dp"
                        android:layout_alignParentLeft="true"
                        android:orientation="horizontal">
                        <CheckBox
                            android:id="@+id/cb_urgent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:button="@drawable/selector_item_file_check_bg"
                            android:checked="@{trayModel.urgent}"
                            android:text="@string/pipe_main_urgent"
                            android:textColor="@color/red"
                            android:textSize="@dimen/font_size_large_20sp"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/confirm_proj_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_centerInParent="true"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="@string/show_config_edit_template"
                        android:textSize="22sp"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
                    <Button
                        android:id="@+id/save_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentRight="true"
                        android:layout_marginRight="30dp"
                        android:paddingLeft="15dp"
                        android:paddingRight="15dp"
                        android:text="@string/subcommit"
                        android:textSize="22sp"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>

<!--                    <Button-->
<!--                        android:id="@+id/stop_btn"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="35dp"-->
<!--                        android:layout_centerVertical="true"-->
<!--                        android:layout_marginRight="20dp"-->
<!--                        android:layout_toLeftOf="@id/start_btn"-->
<!--                        android:background="@drawable/selector_general_btn_bg"-->
