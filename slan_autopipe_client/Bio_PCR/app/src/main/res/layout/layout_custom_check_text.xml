<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/parent_check_layout"
    android:padding="8dp"
    android:orientation="horizontal"
    android:background="@drawable/shape_btn_common_blue">
    <TextView
        android:id="@+id/custom_check_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/item_chanel_uncheck"/>
    <TextView
        android:id="@+id/custom_check_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:textColor="@color/white"
        android:layout_marginLeft="8dp"
        android:textSize="@dimen/font_size_normal_16sp"
        android:text="FAM"/>
  
</LinearLayout>
