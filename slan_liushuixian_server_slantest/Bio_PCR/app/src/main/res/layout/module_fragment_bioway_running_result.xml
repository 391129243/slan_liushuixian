<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingRight="8dp"
    android:paddingLeft="8dp"
    android:paddingBottom="4dp"
    android:paddingTop="4dp"
    android:background="@color/white"
    xmlns:custom="http://schemas.android.com/apk/res-auto">


    <!--通道-->
    <LinearLayout
        android:id="@+id/running_bioway_chanel_layout"
        android:layout_width="128dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:padding="2dp"
        android:layout_marginLeft="12dp"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/running_bioway_channel_1_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/running_select_channel"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/blue"/>
            <com.gidi.bio_pcr.view.CustomCheckText
                android:id="@+id/result_bioway_all_channel_check_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_all_channel_bg"
                custom:content_text="@string/result_all_channel"/>

            <com.gidi.bio_pcr.view.CustomCheckText
                android:id="@+id/running_bioway_result_fam_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_fam_bg"
                custom:content_text="FAM"/>

            <com.gidi.bio_pcr.view.CustomCheckText
                android:id="@+id/running_bioway_result_hex_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_hex_bg"
                custom:content_text="HEX"/>


            <com.gidi.bio_pcr.view.CustomCheckText
                android:id="@+id/running_bioway_result_rox_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_rox_bg"
                custom:content_text="ROX"/>

            <com.gidi.bio_pcr.view.CustomCheckText
                android:id="@+id/running_bioway_result_cy5_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_cy5_bg"
                custom:content_text="CY5"/>



            <TextView
                android:id="@+id/running_bioway_ex_result_more_tv"
                android:layout_width="88dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/more"
                android:drawableTop="@drawable/icon_result_more"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/running_bioway_sec_analyse_tv"
            android:layout_width="128dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:text="@string/second_analyse"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_normal_16sp"
            android:visibility="visible"
            android:background="@drawable/selector_rect_blue_recycle"/>

    </LinearLayout>

    <!--曲线名称-->
    <RadioGroup
        android:id="@+id/result_bioway_curve_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="20dp"
        android:layout_toRightOf="@id/running_bioway_chanel_layout"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <RadioButton
            style="@style/style_tab_system_info"
            android:id="@+id/result_bioway_rawcurve_rb"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/running_curve_virgin"
            />
        <RadioButton
            style="@style/style_tab_system_info"
            android:id="@+id/result_bioway_ampcurve_rb"
            android:layout_marginLeft="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/running_curve_amplify"
            />
        <RadioButton
            style="@style/style_tab_system_info"
            android:id="@+id/result_bioway_meltcurve_rb"
            android:layout_marginLeft="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/running_curve_melt"
            />
        <RadioButton
            style="@style/style_tab_system_info"
            android:id="@+id/result_bioway_peakcurve_rb"
            android:layout_marginLeft="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/running_curve_melt_peak"
            />
        <RadioButton
            style="@style/style_tab_system_info"
            android:id="@+id/result_bioway_list_rb"
            android:layout_marginLeft="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/running_curve_excel"
            />
        <RadioButton
            style="@style/style_tab_system_info"
            android:id="@+id/result_bioway_set_paramter_rb"
            android:layout_marginLeft="4dp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/running_curve_set_paramter" />
    </RadioGroup>
    <!--孔位-->
    <LinearLayout
        android:id="@+id/result_bioway_hole_layout"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingLeft="36dp"
        android:paddingRight="36dp"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_toRightOf="@id/running_bioway_chanel_layout">
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_running_all_hole_ck"
            android:textSize="@dimen/font_size_small_14sp"
            android:text="@string/result_all_hole_check" />
        <!--A8-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_eight_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_one" />
        <!--A7-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_seven_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_two" />
        <!--A6-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_six_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_three" />
        <!--A5-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_five_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_four" />
        <!--A4-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_four_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_five" />
        <!--A6-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_three_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_six" />
        <!--A2-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_two_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_seven" />
        <!--A1-->
        <TextView
            style="@style/style_detect_hole"
            android:id="@+id/result_bioway_hole_one_btn"
            android:layout_marginLeft="54dp"
            android:text="@string/hole_eight" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/result_bioway_curve_chart_layout"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:padding="4dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="20dp"
        android:layout_below="@id/result_bioway_curve_layout"
        android:layout_toRightOf="@id/running_bioway_chanel_layout"
        android:layout_above="@id/result_bioway_hole_layout"
        android:visibility="gone">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/running_result_bioway_curve_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="4dp"
            android:layout_marginTop="10dp"
            android:background="#f3f5f8"/>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/result_bioway_excel_list_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_below="@id/result_bioway_curve_layout"
        android:layout_toRightOf="@id/running_bioway_chanel_layout"
        android:layout_above="@id/result_bioway_hole_layout"
        android:padding="4dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/result_bioway_excel_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!---标题-->
            <include
                android:id="@+id/resut_bioway_list_title_layout"
                layout="@layout/include_result_slan_excel_title_layout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp" />
            <ListView
                android:id="@+id/result_bioway_list_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="1dp"
                android:divider="@color/detect_gray"/>
        </LinearLayout>
    </HorizontalScrollView>
    <!--二次分析的页面-->
    <RelativeLayout
        android:id="@+id/bioway_result_sec_analyse_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:visibility="gone"
        android:padding="4dp"
        android:layout_below="@id/result_bioway_curve_layout"
        android:layout_toRightOf="@id/running_bioway_chanel_layout">
        <!--基本参数，熔解曲线参数标题-->
        <LinearLayout
            android:id="@+id/bioway_result_sec_analyse_param_title_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/bioway_result_basic_param_title_tv"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/white"
                android:text="@string/config_info_basic_parameters"
                android:background="@drawable/shape_rect_blue"/>
            <TextView
                android:id="@+id/bioway_result_melt_param_title_tv"
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:gravity="center"
                android:text="@string/config_info_melt_curve_parameters"
                android:background="@drawable/shape_rect_blue_stroke"/>
        </LinearLayout>
        <!--扩增曲线算法参数-->
        <LinearLayout
            android:id="@+id/bioway_result_sec_analyse_amp_param_layout"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:visibility="visible"
            android:layout_below="@id/bioway_result_sec_analyse_param_title_layout"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_info_amplification_curve_algorithm"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_normal_18sp" />

                <TextView
                    android:id="@+id/bioway_result_sec_analyse_amp_algorithm_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="12dp"
                    android:text="@string/config_info_ampalgorithm_default"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@null"
                    android:src="@drawable/arrow_press" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:background="@color/color_recycle">
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_dye_1"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_channel"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_analyse_type"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_begin_baseline"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_end_baseline"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_optimization"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_auto_threshold"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_manual_threshold"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_digital_filter"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue"/>
            <ListView
                android:id="@+id/bioway_result_sec_analyse_amp_algorithm_lv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="1dp"
                android:divider="@color/blue"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue"/>
        </LinearLayout>
        <!--熔解曲线算法参数-->
        <LinearLayout
            android:id="@+id/bioway_result_sec_analyse_melt_param_layout"
            android:layout_width="match_parent"
            android:layout_height="310dp"
            android:layout_below="@id/bioway_result_sec_analyse_param_title_layout"
            android:visibility="gone"
            android:orientation="vertical">


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@color/color_recycle"
                android:orientation="horizontal">
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_dye_1"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_channel"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_min_temp"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_max_temp"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_melt_algorithm"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_peak_threshold"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_peak_type"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue"/>
            <!--熔解曲线参数-->
            <ListView
                android:id="@+id/bioway_result_sec_analyse_melt_paramter_lv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="1dp"
                android:divider="@color/blue"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue"/>
        </LinearLayout>
        <!--峰型优化-->
        <LinearLayout
            android:id="@+id/bioway_run_result_sec_optimization_layout"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_alignParentBottom="true"
            android:orientation="vertical"
            android:layout_marginBottom="2dp">
            <!--标题-->
            <TextView
                android:layout_width="120dp"
                android:layout_height="32dp"
                android:text="@string/config_info_optimization_peaktype"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/font_size_normal_18sp"
                android:background="@drawable/shape_rect_blue"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/color_recycle"
                android:orientation="horizontal">
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_dye_1"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_channel"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_optimization_enable"
                    android:singleLine="false"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_enhance_lower"
                    android:singleLine="false"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_enhance_upper"
                    android:singleLine="false"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_enhance_gain"
                    android:singleLine="false"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_enhance_weaken"
                    android:singleLine="false"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
                    android:layout_weight="1"
                    android:text="@string/config_info_weaken_gain"
                    android:singleLine="false"
                    android:textColor="@color/black"/>
                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/blue"/>
                <TextView
                    style="@style/style_config_ex_pamram_tv"
