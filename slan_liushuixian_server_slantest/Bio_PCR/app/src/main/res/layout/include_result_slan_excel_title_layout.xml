<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:background="@color/blue">
    <TextView
        android:id="@+id/result_excel_wellname_tv"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_wellname"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_excel_idcard_tv"
        android:layout_width="148dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/result_idcard"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>

    <TextView
        android:id="@+id/result_excel_channel_tv"
        android:layout_width="62dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_channel"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_controlct_tv"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:text="@string/running_excel_controlct"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_controlpeak_tv"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="13sp"
        android:text="@string/running_excel_controlpeak"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <!---阈值或峰高阈值-->
    <TextView
        android:id="@+id/result_run_slan_excel_threshold_tv"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_threshold"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_peekhighthreshold_tv"
        android:layout_width="88dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_peek_highthreshold"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>

    <TextView
        android:id="@+id/result_run_slan_excel_ct_tv"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_title_ct"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_rmvalue_tv"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_title_rm"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_run_slan_excel_tmvalue_tv"
        android:layout_width="82dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/running_excel_title_tm"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_excel_conclusion_ct_tv"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/result_conclusion_one"
        android:textColor="@color/white"/>
    <View
        style="@style/style_portrait_line"
        android:background="@color/white"/>
    <TextView
        android:id="@+id/result_excel_conclusion_tv"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="@string/result_conclusion"
        android:textColor="@color/white"/>
</LinearLayout>