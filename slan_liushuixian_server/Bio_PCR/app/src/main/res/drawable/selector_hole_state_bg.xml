<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 选中状态（蓝色）：系统默认 state_selected -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="#EFF6FF" /> <!-- 蓝色背景 -->
            <stroke android:width="2dp" android:color="#1976D2" /> <!-- 深蓝边框 -->
        </shape>
    </item>
    <!-- 已配置状态（绿色）：自定义属性 state_configured -->
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#D0FAE5" /> <!-- 绿色背景 -->
            <stroke android:width="2dp" android:color="#388E3C" /> <!-- 深绿边框 -->
        </shape>
    </item>
    <!-- 默认状态（灰色） -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#F5F5F5" /> <!-- 浅灰背景 -->
            <stroke android:width="1dp" android:color="#DDDDDD" /> <!-- 灰色边框 -->
        </shape>
    </item>
</selector>