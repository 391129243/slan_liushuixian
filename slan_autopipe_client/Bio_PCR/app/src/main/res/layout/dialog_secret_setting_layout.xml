<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/dialog_export_temp_name_et"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:textColor="@color/blue"
        android:singleLine="true"
        android:textSize="@dimen/font_size_normal_18sp"/>
    <LinearLayout
        android:id="@+id/secret_setting_layout"
        android:layout_below="@id/dialog_export_temp_name_et"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:visibility="invisible"
        android:paddingRight="12dp"
        android:paddingLeft="12dp"
        android:background="@color/white"
        android:layout_centerHorizontal="true"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/secrete_set_ok_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/system_setting_enable_settings"
            android:padding="8dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/shape_general_normal_btn"/>

        <TextView
            android:id="@+id/secrete_set_cancel_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/system_setting_no_enable_settings"
            android:layout_marginLeft="12dp"
            android:padding="8dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/shape_general_pressed_btn"/>




    </LinearLayout>

    <RadioGroup
        android:id="@+id/devicetype_layout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_below="@id/secret_setting_layout"
        android:gravity="center"
        android:orientation="horizontal">
        <RadioButton
            style="@style/style_config_hex_tab"
            android:id="@+id/radiobutton_devicetype_three"
            android:layout_width="158dp"
            android:textSize="19sp"
            android:text="@string/config_devicetype_three"/>
        <RadioButton
            style="@style/style_config_hex_tab"
            android:id="@+id/radiobutton_devicetype_rotate"
            android:layout_width="158dp"
            android:layout_marginLeft="28dp"
            android:textSize="19sp"
            android:text="@string/config_devicetype_rotate"/>
    </RadioGroup>


</RelativeLayout>