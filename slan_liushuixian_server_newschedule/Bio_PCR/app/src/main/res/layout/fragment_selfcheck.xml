<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:custom="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.SelfcheckViewModel" />
    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
<!--        android:background="@drawable/user_main_bg_2"-->
        <View
            android:id="@+id/untouchview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:background="#50000000">
        </View>
        <RelativeLayout
            android:id="@+id/content"
            android:layout_width="1800dp"
            android:layout_height="800dp"
            tools:context="com.paul.pipeline.fragment.SelfcheckFragment"
            android:background="@color/white"
            android:layout_centerInParent="true"
            android:padding="10dp">
            <RelativeLayout
                android:id="@+id/rl_top"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_alignParentTop="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_title"
                    android:textSize="@dimen/pipemain_title"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="10dp"
                    android:text="@string/name_selfcheck" />
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/login_auto_check_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentBottom="true">
                <!--启动自检-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp">
                        <TextView
                            android:id="@+id/user_login_selfcheck_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/system_self_check"
                            android:textColor="#0CBEE2"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/alltray_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#0CBEE2"
                            android:textSize="24sp"
                            android:layout_marginLeft="20dp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/alert_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/red"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true">
                    <Button
                        android:id="@+id/restart_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_marginLeft="20dp"
                        android:layout_alignParentLeft="true"
                        android:padding="10dp"
                        android:text="@string/wss_reconnect"
                        android:textSize="24sp"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_centerInParent="true">

                        <Button
                            android:id="@+id/autoreset_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_marginLeft="20dp"
                            android:padding="10dp"
                            android:text="@string/one_button_reset"
                            android:textSize="24sp"
                            android:textColor="@color/white"
                            android:background="@drawable/selector_general_btn_bg" />

                        <Button
                            android:id="@+id/autobacktray_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_marginLeft="100dp"
                            android:padding="10dp"
                            android:text="@string/one_button_return_tray"
                            android:textSize="24sp"
                            android:textColor="@color/white"
                            android:background="@drawable/selector_general_btn_bg"
                            android:visibility="visible"/>

                        <Button
                            android:id="@+id/autoclearall_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="60dp"
                            android:layout_marginLeft="100dp"
                            android:padding="10dp"
                            android:text="@string/one_button_clear_alltray"
                            android:textSize="24sp"
                            android:textColor="@color/white"
                            android:background="@drawable/selector_general_btn_bg"
                            android:visibility="visible"/>
                    </LinearLayout>
                    <Button
                        android:id="@+id/skip_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:layout_marginRight="20dp"
                        android:layout_alignParentRight="true"
                        android:padding="10dp"
                        android:text="@string/dialog_skipselfcheck"
                        android:textSize="24sp"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
            </RelativeLayout>
            </LinearLayout>
            <LinearLayout
