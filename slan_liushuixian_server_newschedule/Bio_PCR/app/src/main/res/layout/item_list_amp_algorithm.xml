<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:background="@color/white">

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_algrithm_dye_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_algrithm_channel_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:text="4"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_algrithm_analysetype_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_algrithm_beginbase_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_algrithm_endbase_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_algrithm_optimizationmode_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/color_black_blue_selector"/>
        <LinearLayout
            android:id="@+id/item_amp_algrithm_autothreshold_layout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_weight="1"
            android:clickable="false"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/item_amp_algrithm_autothreshold_img"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/check_normal"
                android:contentDescription="@null" />
        </LinearLayout>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_threshold_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
        <TextView
            android:id="@+id/item_amp_algrithm_digitalfilter_tv"
            style="@style/style_config_ex_pamram_tv"
            android:layout_weight="1"
            android:textColor="@color/color_black_blue_selector"/>
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/blue"/>
</androidx.appcompat.widget.LinearLayoutCompat>