<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:background="#f3f5f8">
    <!--序号-->
    <TextView
        android:id="@+id/item_user_result_report_num_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:text="No"
        android:textColor="@color/black"/>
  <!--  <View
        style="@style/style_portrait_line"/>-->
    <!--检测项目-->
    <TextView
        android:id="@+id/item_user_result_report_item_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/black"/>
  <!--  <View
        style="@style/style_portrait_line"/>-->
    <TextView
        android:id="@+id/item_user_result_ct_value_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/black"/>
   <!-- <View
        style="@style/style_portrait_line"/>-->
    <TextView
        android:id="@+id/item_user_result_results_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/black"/>
    <!--<View
        style="@style/style_portrait_line"/>-->
    <TextView
        android:id="@+id/item_user_result_reference_tv"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:gravity="center"
        android:textSize="@dimen/font_size_small_14sp"
        android:textColor="@color/black"/>
   <!-- <View
        style="@style/style_portrait_line"/>-->
</LinearLayout>