<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="#F5F5F5"
    android:padding="14dp">


    <RelativeLayout
        android:id="@+id/run_config_project_btn_layout"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_alignParentRight="true"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/config_run_start_tv"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:text="@string/start"
            android:padding="8dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>
        <TextView
            android:id="@+id/config_run_stop_tv"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/stop"
            android:layout_toRightOf="@id/config_run_start_tv"
            android:layout_marginLeft="12dp"
            android:padding="8dp"
            android:gravity="center"
            android:textSize="@dimen/font_size_normal_18sp"
            android:textColor="@color/color_white_blue_selector"
            android:background="@drawable/selector_general_btn_bg"/>

        <ImageView
            android:id="@+id/config_run_back_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:layout_alignParentRight="true"
            android:src="@drawable/icon_back_1"/>
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/run_config_slan_temp_layout"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/run_config_project_btn_layout"
        android:layout_marginTop="12dp"
        android:paddingLeft="14dp"
        android:paddingTop="8dp"
        android:background="@drawable/common_main_content_bg">
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_project_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white"
            />
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_start_time_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/run_config_slan_project_tv"
            android:layout_marginTop="5dp"
            custom:title_text="@string/running_pcr_project_start_time"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white"
            />
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_project_state_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/run_config_slan_start_time_tv"
            android:layout_marginTop="5dp"
            custom:title_text="@string/running_pcr_project_state"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white"
            />
        <!--运行时间-->
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_running_time_tv"
            android:layout_below="@id/run_config_slan_project_state_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_running_time"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white" />

        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_lasttime_tv"
            android:layout_below="@id/run_config_slan_running_time_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_last_time"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white" />
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_current_program_tv"
            android:layout_below="@id/run_config_slan_lasttime_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_current_program"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white"
            />
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_current_step_tv"
            android:layout_below="@id/run_config_slan_current_program_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_current_step"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white" />

        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_project_loop_tv"
            android:layout_below="@id/run_config_slan_current_step_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_loop"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white"
            />
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_project_temp_tv"
            android:layout_below="@id/run_config_slan_project_loop_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_current_temp"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white"
            />
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_project_tubetemp_tv"
            android:layout_below="@id/run_config_slan_project_temp_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_tube_temp"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white"
            />
        <com.gzlab.autoassemblyline_client.view.CustomTitleText
            android:id="@+id/run_config_slan_project_holdtime_tv"
            android:layout_below="@id/run_config_slan_project_tubetemp_tv"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            custom:title_text="@string/running_pcr_project_hold_time"
            custom:content_text=""
            custom:title_text_color="@color/white"
            custom:content_text_color="@color/white" />
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/run_config_slan_counterdown_layout"
        android:layout_width="340dp"
        android:layout_height="100dp"
        android:padding="4dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/shape_rect_stoke"
        android:layout_below="@id/run_config_slan_temp_layout">
        <LinearLayout
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/run_config_slan_running_step_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:padding="6dp"
                android:gravity="center"
                android:text="@string/running_real_step"
                android:textColor="@color/white"
                android:textSize="@dimen/font_size_normal_16sp"
                android:background="@drawable/shape_general_pressed_btn"/>
            <TextView
                android:id="@+id/run_config_slan_running_curve_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/running_real_data"
                android:padding="6dp"
                android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:textSize="@dimen/font_size_normal_16sp"
                android:background="@drawable/shape_general_normal_btn"/>
        </LinearLayout>
        <TextView
            android:id="@+id/run_config_slan_pcr_countdown_tv"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:textColor="@color/blue"
            android:layout_marginLeft="20dp"
            android:layout_centerVertical="true"
            android:textSize="@dimen/font_size_normal_18sp"
            android:gravity="center"
            android:background="@drawable/shape_oval_blue_stroke_bg"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_pcr"
            android:textSize="@dimen/font_size_large_20sp"
            android:textColor="@color/blue"
            android:visibility="gone"
            android:gravity="center"
            android:layout_centerVertical="true"
            android:layout_marginLeft="10dp"
            android:layout_toRightOf="@id/run_config_slan_pcr_countdown_tv"/>

    </LinearLayout>



    <HorizontalScrollView
        android:id="@+id/run_config_slan_step_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/run_config_slan_temp_layout"
        android:layout_marginTop="12dp"
        android:layout_below="@id/run_config_project_btn_layout"
        android:layout_marginLeft="8dp"
        android:visibility="visible">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/run_config_slan_program_title_layout"
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:layout_height="48dp">
            </LinearLayout>
            <LinearLayout
                android:id="@+id/run_config_slan_program_recycle_layout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                    >
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/run_config_slan_rv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/run_config_slan_program_title_layout"
                android:layout_above="@id/run_config_slan_program_recycle_layout"/>
        </RelativeLayout>
    </HorizontalScrollView>


        <!--曲綫-->
    <RelativeLayout
        android:id="@+id/run_config_slan_running_chart_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/run_config_slan_temp_layout"
        android:layout_marginTop="12dp"
        android:layout_below="@id/run_config_project_btn_layout"
        android:layout_marginLeft="8dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/run_config_slan_running_channel_layout"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:padding="2dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/running_select_channel"
                android:textSize="@dimen/font_size_normal_18sp"
                android:textColor="@color/blue"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/run_config_slan_all_channel_check_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_all_channel_bg"
                custom:content_text="@string/result_all_channel"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/run_config_slan_running_result_fam_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_fam_bg"
                custom:content_text="FAM"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/run_config_slan_running_result_hex_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_hex_bg"
                custom:content_text="HEX"/>


            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/run_config_slan_running_result_rox_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_rox_bg"
                custom:content_text="ROX"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/run_config_slan_running_result_cy5_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_quasar_bg"
                custom:content_text="CY5"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/run_config_slan_running_result_quasar_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_atto_bg"
                custom:content_text="QUASAR"/>

            <com.gzlab.autoassemblyline_client.view.CustomCheckText
                android:id="@+id/run_config_slan_running_result_atto_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                custom:content_img="@drawable/item_chanel_uncheck"
                custom:background_img="@drawable/shape_channel_cy5_bg"
                custom:content_text="ATTO"/>
        </LinearLayout>
        <!--曲线名称-->
        <RadioGroup
            android:id="@+id/run_config_slan_running_curve_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@id/run_config_slan_running_channel_layout"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/run_config_slan_running_rawcurve_rb"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_virgin" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/run_config_slan_running_ampcurve_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_amplify"
                    />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/run_config_slan_running_meltcurve_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_melt" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/run_config_result_slan_peakcurve_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_melt_peak" />
            <RadioButton
                style="@style/style_tab_system_info"
                android:id="@+id/run_config_result_slan_list_rb"
                android:layout_marginLeft="4dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/running_curve_excel" />
        </RadioGroup>
        <LinearLayout
            android:id="@+id/run_config_slan_result_hole_layout"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_toRightOf="@id/run_config_slan_running_channel_layout">
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_all_hole_ck"
                android:textSize="@dimen/font_size_small_14sp"
                android:text="@string/result_all_hole_check" />
            <!--A8-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_eight_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_one" />
            <!--A7-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_seven_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_two" />
            <!--A6-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_six_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_three" />
            <!--A5-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_five_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_four" />
            <!--A4-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_four_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_five" />
            <!--A3-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_three_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_six" />
            <!--A2-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_two_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_seven" />
            <!--A1-->
            <TextView
                style="@style/style_detect_hole"
                android:id="@+id/run_config_slan_running_hole_one_tv"
                android:layout_marginLeft="32dp"
                android:text="@string/hole_eight" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/run_config_slan_result_curve_chart_layout"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:padding="4dp"
            android:visibility="visible"
            android:layout_below="@id/run_config_slan_running_curve_layout"
            android:layout_toRightOf="@id/run_config_slan_running_channel_layout"
            android:layout_above="@id/run_config_slan_result_hole_layout">

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/run_config_slan_running_result_curve_chart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:layout_marginTop="10dp"
                android:background="#f3f5f8"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/run_config_slan_result_slan_excel_layout"
            android:layout_width="820dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginBottom="20dp"
            android:layout_marginLeft="4dp"
            android:visibility="gone"
            android:layout_below="@id/run_config_slan_running_curve_layout"
            android:layout_toRightOf="@id/run_config_slan_running_channel_layout"
            android:layout_above="@id/run_config_slan_result_hole_layout">

                <!---标题-->
            <include
                android:id="@+id/run_config_result_slan_list_title_layout"
                layout="@layout/include_run_config_slan_excel_title_layout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp" />
            <ListView
                android:id="@+id/run_config_result_slan_list_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:dividerHeight="1dp"
                android:divider="@color/detect_gray"/>

        </LinearLayout>

    </RelativeLayout>


</RelativeLayout>