<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/index"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>
        <TextView
            android:id="@+id/ip_port"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>
        <TextView
            android:id="@+id/device_type"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>
        <TextView
            android:id="@+id/position"
            android:layout_width="40dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/deviceid"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/degree"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/degreetarget"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"/>



        <TextView
            android:id="@+id/no"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/remaintime"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>


    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/template"
            android:layout_width="300dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/linuxstatus"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/linuxalarm"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/alarm"
            android:layout_width="180dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/version"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/lefttime"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/totaltime"
            android:layout_width="60dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>
        <TextView
            android:id="@+id/sendalarm"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/currenttray"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/runninginfo"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/info"
            android:layout_width="200dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/currentsection"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/currentstep"
            android:layout_width="150dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/currentcycle"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/totalcycle"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/runningtime"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>

        <TextView
            android:id="@+id/waittime"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:layout_marginTop="0dp"/>


    </LinearLayout>
</LinearLayout>