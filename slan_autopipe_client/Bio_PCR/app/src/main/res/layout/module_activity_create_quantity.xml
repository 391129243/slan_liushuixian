<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:background="#f5f5f5">

    <!--标题-->
    <include
        android:id="@+id/quantity_single_create_title_layout"
        layout="@layout/include_common_title_layout"/>

    <!--已选中的文件-->
    <LinearLayout
        android:id="@+id/quantity_single_create_tab_layout"
        android:layout_width="348dp"
        android:layout_height="match_parent"
        android:layout_below="@id/quantity_single_create_title_layout"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/shape_rect_white_bg"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/shape_rect_blue_2_corners"
            android:gravity="center"
            android:text="@string/create_multi_template_selected"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_large_20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quantity_create_filename_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/create_multi_template_name"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp" />

            <EditText
                android:id="@+id/quantity_single_create_template_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:background="@drawable/shape_rect_stoke"
                android:inputType="none"
                android:padding="4dp"
                android:singleLine="true"
                android:text="quantity-"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quantity_single_create_filename_second_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/create_multi_template_second_name"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp" />

            <EditText
                android:id="@+id/quantity_single_create_template_name_second_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:background="@drawable/shape_rect_stoke"
                android:inputType="none"
                android:padding="4dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quantity_single_create_filename_third_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/create_multi_template_third_name"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp" />

            <EditText
                android:id="@+id/quantity_single_create_template_name_third_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:background="@drawable/shape_rect_stoke"
                android:inputType="none"
                android:padding="4dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/quantity_single_create_totaltime_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/create_multi_template_time"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp" />

            <EditText
                android:id="@+id/quantity_single_create_totaltime_et"
                android:layout_width="188dp"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:layout_marginLeft="4dp"
                android:background="@drawable/shape_rect_stoke"
                android:inputType="number"
                android:padding="4dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginLeft="8dp"
                android:text="s"
                android:textColor="@color/blue"
                android:textSize="@dimen/font_size_normal_18sp" />

        </LinearLayout>
        <!--控温方式-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="@color/blue"
                android:gravity="center"
                android:textSize="@dimen/font_size_normal_18sp"
                android:text="@string/create_multi_temperature_control"/>
            <RadioGroup
                android:id="@+id/quantity_single_create_tempctrl_mode_rg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/quantity_single_create_tempctrl_fast"
                    style="@style/style_tab_temperature_ctrl_rb"
                    android:checked="true"
                    android:paddingRight="8dp"
                    android:layout_width="88dp"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:text="@string/create_multi_temperature_fast"/>
                <RadioButton
                    android:id="@+id/quantity_single_create_tempctrl_standard"
                    style="@style/style_tab_temperature_ctrl_rb"
                    android:layout_marginLeft="6dp"
                    android:layout_width="120dp"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/font_size_normal_18sp"
                    android:text="@string/create_multi_temperature_standard"/>
            </RadioGroup>
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="380dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.gzlab.autoassemblyline_client.view.CustomImageText
                    android:id="@+id/quantity_single_create_rna_title_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/rna_extraction"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="1"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/quantity_single_create_rna_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />


                <com.gzlab.autoassemblyline_client.view.CustomImageText
                    android:id="@+id/quantity_single_create_pcr_title_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/single_template_first_pcr"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="2"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/quantity_single_create_pcr_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
                <com.gzlab.autoassemblyline_client.view.CustomImageText
                    android:id="@+id/quantity_single_create_standard_curve_title_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/creare_quantity_standard_curve"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="3"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/quantity_single_create_standard_curve_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
                <com.gzlab.autoassemblyline_client.view.CustomImageText
                    android:id="@+id/quantity_single_create_peak_title_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/create_multi_peak_judge_file"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="4"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/quantity_single_create_peak_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
                <com.gzlab.autoassemblyline_client.view.CustomImageText
                    android:id="@+id/quantity_single_create_judge_title_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    custom:content_img="@drawable/shape_oval_top_bg"
                    custom:content_text="@string/create_multi_ct_judge_file"
                    custom:content_text_color="@color/blue"
                    custom:image_content_text="5"
                    custom:image_content_text_color="@color/white" />

                <TextView
                    android:id="@+id/quantity_single_create_judge_name_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/black"
                    android:textSize="@dimen/font_size_normal_18sp" />
            </LinearLayout>
        </ScrollView>


        <TextView
            android:id="@+id/quantity_single_create_save_btn"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:background="@drawable/selector_general_btn_bg"
            android:gravity="center"
            android:padding="4dp"
            android:text="@string/create_multi_template_save"
            android:textColor="@color/white"
            android:textSize="@dimen/font_size_normal_18sp" />
    </LinearLayout>

    <!--显示RNA文件列表-->
    <RelativeLayout
        android:id="@+id/quantity_single_create_rna_file_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/quantity_single_create_tab_layout"
        android:layout_below="@id/quantity_single_create_title_layout"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginRight="12dp"
        android:visibility="visible"
        android:background="@drawable/shape_rect_white_bg">
        <TextView
            style="@style/style_common_title_tv"
            android:id="@+id/quantity_single_create_hex_list_title"
            android:layout_width="wrap_content"
            android:text="@string/create_multi_rna_extraction_file"
            android:textColor="@color/blue" />
        <TextView
            style="@style/style_common_create_title_tv"
            android:id="@+id/quantity_single_create_hex_create_tv"
            android:layout_width="wrap_content"
            android:layout_alignParentRight="true"
            android:text="@string/create_single_rna_title"
            android:background="@drawable/selector_general_btn_bg"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quantity_single_create_hex_file_list"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_below="@id/quantity_single_create_hex_create_tv" />

        <!--RNA文件详情-->
        <include
            layout="@layout/include_common_hex_detail_layout"
            android:id = "@+id/quantity_single_hex_detail_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/quantity_single_create_hex_file_list"/>

    </RelativeLayout>

    <!--显示PCR文件列表和详情-->
    <RelativeLayout
        android:id="@+id/quantity_single_create_pcr_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/quantity_single_create_tab_layout"
        android:layout_below="@id/quantity_single_create_title_layout"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/shape_rect_white_bg"
        android:visibility="gone">
        <TextView
            style="@style/style_common_title_tv"
            android:id="@+id/quantity_single_create_pcr_list_title"
            android:layout_width="wrap_content"
            android:text="@string/create_multi_pcr_file"
            android:textColor="@color/blue" />

        <TextView
            style="@style/style_common_create_title_tv"
            android:id="@+id/quantity_single_create_pcr_create_tv"
            android:layout_width="wrap_content"
            android:layout_alignParentRight="true"
            android:text="@string/create_multi_create_pcr_file"
            android:background="@drawable/selector_general_btn_bg"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quantity_single_create_pcr_list"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:layout_below="@id/quantity_single_create_pcr_list_title"/>


        <HorizontalScrollView
            android:id="@+id/quantity_single_create_step_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/quantity_single_create_pcr_list"
            android:visibility="visible">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <LinearLayout
                    android:id="@+id/quantity_single_create_program_title_layout"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="48dp">
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/quantity_single_create_program_recycle_layout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_alignParentBottom="true"
                    android:orientation="horizontal"
                    >
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quantity_single_create_slan_program_rv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:layout_below="@id/quantity_single_create_program_title_layout"
                    android:layout_above="@id/quantity_single_create_program_recycle_layout"/>
            </RelativeLayout>
        </HorizontalScrollView>

    </RelativeLayout>

    <!--显示标准曲线详情和列表-->
    <RelativeLayout
        android:id="@+id/quantity_single_create_standardcurve_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/quantity_single_create_tab_layout"
        android:layout_below="@id/quantity_single_create_title_layout"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/shape_rect_white_bg"
        android:visibility="gone">
        <TextView
            style="@style/style_common_title_tv"
            android:id="@+id/quantity_single_create_standard_file_title"
            android:layout_width="wrap_content"
            android:text="标准曲线文件"
            android:textColor="@color/blue" />

        <TextView
            style="@style/style_common_create_title_tv"
            android:id="@+id/quantity_single_create_standard_curve_tv"
            android:layout_width="wrap_content"
            android:layout_alignParentRight="true"
            android:text="外部标准曲线文件"
            android:background="@drawable/selector_general_btn_bg"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quantity_single_create_standard_list"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="12dp"
            android:layout_below="@id/quantity_single_create_standard_curve_tv"/>

        <RadioGroup
            android:id="@+id/quantity_single_std_rg"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_below="@id/quantity_single_create_standard_list"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/quantity_single_std_num_1_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="1"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_left_rb_bg"/>
            <RadioButton
                android:id="@+id/quantity_single_std_num_2_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="2"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/quantity_single_std_num_3_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="3"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/quantity_single_std_num_4_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="4"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/quantity_single_std_num_5_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="5"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_middle_rb_bg"/>
            <RadioButton
                android:id="@+id/quantity_single_std_num_6_rb"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:text="6"
                android:visibility="gone"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="@dimen/font_size_normal_18sp"
                android:button="@null"
                android:background="@drawable/selector_std_right_rb_bg"/>
        </RadioGroup>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/quantity_single_standard_curve_detail_layout"
            android:layout_below="@id/quantity_single_std_rg"
            android:visibility="visible">
            <!--显示曲线的-->
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/quantity_single_std_curve_chart"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingBottom="4dp"
                android:background="#f3f5f8"/>

            <!--显示曲线的具体内容-->

            <LinearLayout
                android:id="@+id/quantity_chart_params_layout"
                android:visibility="gone"
                android:layout_width="168dp"
                android:layout_height="102dp"
                android:layout_alignParentRight="true"
                android:layout_marginTop="40dp"
                android:layout_marginRight="40dp"
                android:orientation="vertical"
                android:gravity="left"
                android:padding="5dp"
                android:background="@drawable/shape_rect_stoke">
                <TextView
                    android:id="@+id/quantity_chart_slope_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
                <TextView
                    android:id="@+id/quantity_chart_intercept_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
                <TextView
                    android:id="@+id/quantity_chart_r_value_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
                <TextView
                    android:id="@+id/quantity_chart_efficiency_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="@dimen/font_size_normal_16sp"
                    android:textColor="@color/blue"/>
            </LinearLayout>
        </RelativeLayout>

    </RelativeLayout>

    <!--判别文件列表-->
    <RelativeLayout
        android:id="@+id/quantity_single_create_judge_file_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toRightOf="@id/quantity_single_create_tab_layout"
        android:layout_below="@id/quantity_single_create_title_layout"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginRight="12dp"
        android:background="@color/white"
        android:visibility="gone">
        <TextView
            style="@style/style_common_title_tv"
            android:id="@+id/quantity_single_create_judge_list_title"
            android:layout_width="140dp"
            android:text="@string/create_multi_judge_file"
            android:textColor="@color/blue" />
        <TextView
            style="@style/style_common_create_title_tv"
            android:id="@+id/quantity_single_create_ct_create_tv"
            android:layout_width="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_alignParentRight="true"
            android:text="@string/create_multi_create_judge_ct_file"
            android:background="@drawable/selector_general_btn_bg"/>
        <TextView
            style="@style/style_common_create_title_tv"
            android:layout_width="wrap_content"
            android:id="@+id/quantity_single_create_peak_create_tv"
            android:layout_toLeftOf="@id/quantity_single_create_ct_create_tv"
            android:text="@string/create_multi_create_judge_peak_file"
            android:background="@drawable/selector_general_btn_bg"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quantity_single_create_judge_list"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_below="@id/quantity_single_create_judge_list_title"/>

        <!--判别文件的详情-->
        <!--单重判别文件-->
        <include
            layout="@layout/include_common_ct_detail_layout"
            android:id="@+id/config_judge_single_ct_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:layout_below="@id/quantity_single_create_judge_list"
            android:visibility="gone">
        </include>

        <!---duo重判别文件peaklayout-->
        <include
            layout="@layout/include_common_peak_detail_layout"
            android:id="@+id/quantity_single_judge_peak_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp"
            android:layout_below="@id/quantity_single_create_judge_list"
            android:visibility="gone">
        </include>
    </RelativeLayout>
</RelativeLayout>