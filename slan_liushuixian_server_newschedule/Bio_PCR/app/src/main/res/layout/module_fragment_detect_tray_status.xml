<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!--打开舱门提示-->
    <TextView
        android:id="@+id/detect_wait_open_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:paddingRight="48dp"
        android:paddingLeft="48dp"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:background="@drawable/shape_general_pressed_btn"
        android:text="@string/detect_open_tray"
        android:textSize="@dimen/font_size_large_22sp"
        android:textColor="@color/white"/>
    <!--等待舱门页面-->
    <RelativeLayout
        android:id="@+id/detect_tray_wait_layout"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_centerInParent="true"
        android:background="@drawable/shape_oval_status_bg"
        android:orientation="vertical"
        android:visibility="gone"
        >
        <TextView
            android:id="@+id/detect_tray_wait_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:layout_marginTop="60dp"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="@string/detect_wait_tray"
            android:textSize="@dimen/font_size_large_22sp"
            android:textColor="@color/white"/>

        <TextView
            android:id="@+id/detect_wait_tray_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detect_tray_wait_hint"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:textColor="@color/white"
            android:textSize="32sp" />

    </RelativeLayout>
</RelativeLayout>