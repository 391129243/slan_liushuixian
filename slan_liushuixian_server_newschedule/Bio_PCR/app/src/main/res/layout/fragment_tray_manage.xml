<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.paul.pipeline.fragment.TrayManageFragment">
    <data>
        <variable
            name="trayModel"
            type="com.paul.pipeline.fragment.model.PipeTrayModel" />
        <variable
            name="viewModel"
            type="com.paul.pipeline.fragment.viewmodel.TrayManageViewModel" />
    </data>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/untouchview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:background="#50000000">
        </View>
        <RelativeLayout
            android:id="@+id/content"
            android:layout_width="1280dp"
            android:layout_height="820dp"
            app:stringStatusImg="@{trayModel.status}"
            android:layout_centerInParent="true"
            android:padding="10dp">
            <RelativeLayout
                android:id="@+id/top_rl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentTop="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_title"
                    android:textSize="@dimen/pipemain_title"
                    android:layout_centerVertical="true"
                    android:layout_alignParentLeft="true"
                    android:layout_marginLeft="10dp"
                    android:text="@{trayModel.name}" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/content_title"
                    android:textSize="@dimen/pipemain_text"
                    android:layout_centerInParent="true"
                    app:stringStatus="@{trayModel.status}" />

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="20dp"
                    android:padding="10dp"
                    android:background="@drawable/icon_back_1"/>
            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:layout_below="@id/top_rl"
                android:layout_above="@id/bottom_ll">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/common_main_content_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/pipemain_title"
                        android:layout_centerVertical="true"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="10dp"
                        android:text="@string/sample_current" />
                </RelativeLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/samplehole_rv"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/common_main_content_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/pipemain_title"
                        android:layout_centerVertical="true"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="10dp"
                        android:text="@string/batch_current" />
                </RelativeLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingLeft="10dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_user_main_text"
                            android:textSize="@dimen/pipemain_text"
                            android:layout_centerVertical="true"
                            android:layout_alignParentLeft="true"
                            android:text="@string/result_batchCode" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/content_title"
                            android:textSize="@dimen/pipemain_text"
                            android:ellipsize="marquee"
                            android:maxLines="2"
                            android:textAlignment="textStart"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="5dp"
                            android:text="@{trayModel.batch}" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_user_main_text"
                            android:textSize="@dimen/pipemain_text"
                            android:layout_centerVertical="true"
                            android:layout_alignParentLeft="true"
                            android:text="@string/config_info_project_title" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/content_title"
                            android:textSize="@dimen/pipemain_text"
                            android:layout_centerVertical="true"
                            android:layout_marginLeft="5dp"
                            android:text="@{trayModel.project}" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:orientation="vertical">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:orientation="horizontal">
                        <RelativeLayout
                            android:layout_width="50dp"
                            android:layout_height="match_parent">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="@string/number_step"
                                android:layout_centerInParent="true"
                                android:textColor="@color/color_user_main_text"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="200dp"
                            android:layout_height="match_parent">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pcr_step"
                                android:layout_centerInParent="true"
                                android:textColor="@color/color_user_main_text"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:layout_width="150dp"
                            android:layout_height="match_parent">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:text="@string/pipe_main_template_name"
                                android:textColor="@color/color_user_main_text"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </RelativeLayout>
                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pipe_main_aim_position"
                                android:textColor="@color/color_user_main_text"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/pipe_main_taskrunning"
                                android:textColor="@color/color_user_main_text"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="200dp"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/record_ex_start_time"
                                android:layout_centerInParent="true"
                                android:textColor="@color/color_user_main_text"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="200dp"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/record_ex_end_time"
                                android:textColor="@color/color_user_main_text"
                                android:textStyle="bold"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dispatch_rv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </LinearLayout>


            </LinearLayout>
            <LinearLayout
                android:id="@+id/bottom_ll"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_centerInParent="true">

                    <TextView
                        android:id="@+id/alert_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:textColor="#0CBEE2"
                        android:textSize="@dimen/font_size_xlarge_28sp"
                        android:textStyle="bold" />

                </LinearLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_centerInParent="true">
                    <Button
                        android:id="@+id/modify_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginLeft="30dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="@string/modify"
                        android:textSize="@dimen/pipemain_btn"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"
                        android:visibility="gone"/>
                    <Button
                        android:id="@+id/stop_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginLeft="30dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="@string/stop"
                        android:textSize="@dimen/pipemain_btn"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
                    <Button
                        android:id="@+id/clear_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginLeft="30dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="@string/main_set_free"
                        android:textSize="@dimen/pipemain_btn"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
                    <Button
                        android:id="@+id/add_btn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginLeft="30dp"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="@string/add_new"
                        android:textSize="@dimen/pipemain_btn"
                        android:textColor="@color/white"
                        android:background="@drawable/selector_general_btn_bg"/>
                </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</layout>
